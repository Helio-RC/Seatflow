{
  "test": {
    "runner": "Microsoft.Testing.Platform"
  },
  "scripts": {
    "build": "dotnet build",
    "test": "dotnet test",
    "run": "dotnet run --project src/SeatFlow.Desktop",
    "web": "dotnet publish src/SeatFlow.Browser -c Release",
    "desktop": "dotnet publish src/SeatFlow.Desktop -c Release",
    "clean": "dotnet clean",
    "format": "dotnet format",
    "ci": "dotnet r build && dotnet r test"
  }
}
