<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Controls.StudentRosterTable"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:SeatFlow.Presentation.Avalonia.Controls"
  xmlns:conv="using:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:Name="RosterTable"
  x:DataType="controls:StudentRosterTable">

  <UserControl.Resources>
    <conv:GenderIndexConverter x:Key="GenderConverter" />
    <conv:HeightConverter x:Key="HeightConverter" />

    <!--  名单行模板（人员管理页与 OOBE 共用；显示态仅 TextBlock，编辑态才渲染输入控件与操作按钮）  -->
    <DataTemplate x:Key="StudentRowTemplate" x:DataType="vm:StudentRowViewModel">
      <Border
        Height="36"
        Background="Transparent"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="0,0,0,1"
        KeyDown="OnRowEditKeyDown"
        PointerPressed="OnStudentRowPointerPressed">
        <Grid Margin="6,0" ColumnDefinitions="2*,*,*,Auto,Auto">
          <!--  姓名  -->
          <Panel Grid.Column="0">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding Name}"
              TextTrimming="CharacterEllipsis" />
            <TextBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              KeyDown="OnRowEditKeyDown"
              Text="{Binding NameText, Mode=TwoWay}" />
          </Panel>
          <!--  身高  -->
          <Panel Grid.Column="1">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm sf-num"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding HeightDisplay}" />
            <TextBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              KeyDown="OnRowEditKeyDown"
              Text="{Binding Height, Mode=TwoWay, Converter={StaticResource HeightConverter}}" />
          </Panel>
          <!--  性别  -->
          <Panel Grid.Column="2">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding GenderDisplay}" />
            <ComboBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              SelectedIndex="{Binding GenderIndex, Mode=TwoWay}">
              <ComboBoxItem Content="" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Male}" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Female}" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Other}" />
            </ComboBox>
          </Panel>
          <!--  前排  -->
          <Panel Grid.Column="3" Width="64">
            <fic:FluentIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource SfAccentBrush}"
              Icon="{x:Static ficEnum:Icon.CheckmarkCircle}"
              IsVisible="{Binding NeedsFrontRow}" />
            <CheckBox
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsChecked="{Binding IsFrontRow, Mode=TwoWay}"
              IsVisible="{Binding IsEditing}" />
          </Panel>
          <!--  操作（仅编辑态渲染，显示态该列为空）  -->
          <StackPanel
            Grid.Column="4"
            Width="60"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="2"
            IsVisible="{Binding IsEditing}">
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Save}"
              Classes="sf-btn sf-icon sf-ghost"
              Command="{Binding $parent[controls:StudentRosterTable].Editor.EndEditCommand}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{x:Static lang:Resources.Common_Save}">
              <fic:FluentIcon
                FontSize="14"
                Foreground="{DynamicResource SfAccentBrush}"
                Icon="{x:Static ficEnum:Icon.CheckmarkCircle}" />
            </Button>
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Delete}"
              Classes="sf-btn sf-icon sf-ghost"
              Command="{Binding $parent[controls:StudentRosterTable].Editor.DeleteStudentCommand}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{x:Static lang:Resources.Common_Delete}">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--  名单行：固定行高，容器零内边距  -->
    <Style Selector="ListBox.sf-table ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Grid MinWidth="480" RowDefinitions="Auto,*,Auto">
      <!--  表头  -->
      <Border
        Grid.Row="0"
        Padding="12,8"
        Background="{DynamicResource SfSurface2Brush}"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="2*,*,*,Auto,Auto">
          <TextBlock Grid.Column="0" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Name}" />
          <TextBlock Grid.Column="1" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Height}" />
          <TextBlock Grid.Column="2" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Gender}" />
          <TextBlock
            Grid.Column="3"
            Width="64"
            Classes="sf-xs"
            FontWeight="SemiBold"
            Text="{x:Static lang:Resources.Member_FrontRow}" />
          <TextBlock Grid.Column="4" Width="60" Classes="sf-xs" Text="" />
        </Grid>
      </Border>

      <!--  ≤300 行：非虚拟化（WASM 实测滚动零长任务；全部行一次性实例化）  -->
      <ListBox
        x:Name="StudentListBox"
        Grid.Row="1"
        AutomationProperties.Name="{x:Static lang:Resources.Member_Title}"
        Classes="sf-table"
        IsVisible="{Binding #RosterTable.Editor.UseStaticRoster}"
        ItemTemplate="{StaticResource StudentRowTemplate}"
        ItemsSource="{Binding #RosterTable.Editor.Students}"
        MaxHeight="{Binding #RosterTable.ListMaxHeight}"
        ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
      </ListBox>

      <!--  >300 行：虚拟化（控制内存/首帧；滚动按需实例化）  -->
      <ListBox
        Grid.Row="1"
        AutomationProperties.Name="{x:Static lang:Resources.Member_Title}"
        Classes="sf-table"
        IsVisible="{Binding #RosterTable.Editor.UseVirtualization}"
        ItemTemplate="{StaticResource StudentRowTemplate}"
        ItemsSource="{Binding #RosterTable.Editor.Students}"
        MaxHeight="{Binding #RosterTable.ListMaxHeight}"
        ScrollViewer.VerticalScrollBarVisibility="Auto" />

      <!--  底部新增行  -->
      <Border
        x:Name="NewStudentRow"
        Grid.Row="2"
        Padding="6,3"
        Background="{DynamicResource SfSurface2Brush}"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="2*,*,*,Auto,Auto">
          <TextBox
            Name="NewStudentNameBox"
            Grid.Column="0"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Classes="sf-input"
            Height="28"
            KeyDown="OnNewStudentNameKeyDown"
            PlaceholderText="{x:Static lang:Resources.Member_NewRowHint}"
            Text="{Binding #RosterTable.Editor.NewStudent.Name, Mode=TwoWay}" />
          <TextBox
            Grid.Column="1"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Classes="sf-input"
            Height="28"
            PlaceholderText="{x:Static lang:Resources.Member_HeightPH}"
            Text="{Binding #RosterTable.Editor.NewStudent.Height, Mode=TwoWay, Converter={StaticResource HeightConverter}}" />
          <ComboBox
            Grid.Column="2"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Classes="sf-input"
            Height="28"
            SelectedIndex="{Binding #RosterTable.Editor.NewStudent.Gender, Mode=TwoWay, Converter={StaticResource GenderConverter}}">
            <ComboBoxItem Content="" />
            <ComboBoxItem Content="{x:Static lang:Resources.Gender_Male}" />
            <ComboBoxItem Content="{x:Static lang:Resources.Gender_Female}" />
            <ComboBoxItem Content="{x:Static lang:Resources.Gender_Other}" />
          </ComboBox>
          <CheckBox
            Grid.Column="3"
            Width="64"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsChecked="{Binding #RosterTable.Editor.NewStudent.NeedsFrontRow, Mode=TwoWay}" />
          <Button
            Grid.Column="4"
            Width="60"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Member_AddRow}"
            Classes="sf-btn sf-sm"
            Command="{Binding #RosterTable.Editor.AddNewStudentCommand}"
            ToolTip.Tip="{x:Static lang:Resources.Member_AddRow}">
            <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Add}" />
          </Button>
        </Grid>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
