<!--
  方向 B 间距 / 圆角 / 尺寸令牌（来源：html-sample tokens.css 的 sp / r 系列与控件尺寸）。
  用法：Value="{StaticResource SfSpace3}"（数值不随主题变化，用 StaticResource 即可）。
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--  间距  -->
  <x:Double x:Key="SfSpace1">4</x:Double>
  <x:Double x:Key="SfSpace2">8</x:Double>
  <x:Double x:Key="SfSpace3">12</x:Double>
  <x:Double x:Key="SfSpace4">16</x:Double>
  <x:Double x:Key="SfSpace5">24</x:Double>

  <!--  圆角  -->
  <CornerRadius x:Key="SfRadiusXs">3</CornerRadius>
  <CornerRadius x:Key="SfRadiusSm">5</CornerRadius>
  <CornerRadius x:Key="SfRadiusLg">8</CornerRadius>
  <CornerRadius x:Key="SfRadiusPill">999</CornerRadius>

  <!--  页面 / 卡片内边距  -->
  <Thickness x:Key="SfPagePadding">16</Thickness>
  <Thickness x:Key="SfCardPadding">16</Thickness>
  <Thickness x:Key="SfCommandBarPadding">16,8</Thickness>
  <Thickness x:Key="SfPanelPadding">12</Thickness>

  <!--  布局尺寸  -->
  <x:Double x:Key="SfRailWidth">172</x:Double>
  <x:Double x:Key="SfRailCollapsedWidth">64</x:Double>
  <x:Double x:Key="SfStatusHeight">28</x:Double>
  <x:Double x:Key="SfRowHeight">32</x:Double>
  <x:Double x:Key="SfCtlHeight">30</x:Double>
  <x:Double x:Key="SfSeatSize">38</x:Double>
  <x:Double x:Key="SfCanvasGridStep">24</x:Double>

</ResourceDictionary>
