<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.VenueConfigurationView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:SeatFlow.Presentation.Avalonia.Controls"
  xmlns:conv="using:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:VenueConfigurationViewModel">

  <DockPanel>
    <!--  ═══════════════ 顶部命令栏  ═══════════════  -->
    <Border Classes="sf-toolbar" DockPanel.Dock="Top">
      <DockPanel>
        <StackPanel
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          Orientation="Horizontal"
          Spacing="8">
          <TextBlock
            VerticalAlignment="Center"
            Classes="sf-h1"
            Text="{x:Static lang:Resources.Venue_Title}" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="sf-sm sf-dim"
            IsVisible="{Binding HasSelectedVenue}"
            Text="{Binding LayoutName}" />
          <StackPanel
            VerticalAlignment="Center"
            IsVisible="{Binding HasSelectedVenue}"
            Orientation="Horizontal"
            Spacing="6">
            <Border Classes="sf-chip sf-warn" IsVisible="{Binding DirtyTracker.IsDirty}">
              <TextBlock
                Classes="sf-xs"
                Foreground="{DynamicResource SfWarnBrush}"
                Text="{x:Static lang:Resources.Venue_StateUnsaved}" />
            </Border>
            <Border Classes="sf-chip sf-ok" IsVisible="{Binding DirtyTracker.IsDirty, Converter={x:Static conv:BoolConverters.Negate}}">
              <TextBlock
                Classes="sf-xs"
                Foreground="{DynamicResource SfOkBrush}"
                Text="{x:Static lang:Resources.Venue_StateSaved}" />
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel
          DockPanel.Dock="Right"
          HorizontalAlignment="Right"
          Orientation="Horizontal"
          Spacing="8">
          <Button
            Classes="sf-btn"
            Command="{Binding RenameVenueCommand}"
            IsEnabled="{Binding HasSelectedVenue}"
            ToolTip.Tip="{x:Static lang:Resources.Common_Rename}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Edit}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Rename}" />
            </StackPanel>
          </Button>
          <Button
            Classes="sf-btn sf-danger"
            Command="{Binding DeleteVenueCommand}"
            IsEnabled="{Binding HasSelectedVenue}"
            ToolTip.Tip="{x:Static lang:Resources.Venue_DeleteVenue}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Delete}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="SaveVenueButton"
            Classes="sf-btn sf-primary"
            Command="{Binding SaveVenueCommand}"
            IsEnabled="{Binding CanSaveVenue}"
            ToolTip.Tip="{x:Static lang:Resources.Venue_SaveVenue}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Save}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══════════════ 底部状态栏  ═══════════════  -->
    <Border Classes="sf-statusbar" DockPanel.Dock="Bottom">
      <Grid Margin="16,0" ColumnDefinitions="*,Auto">
        <TextBlock
          VerticalAlignment="Center"
          Classes="sf-xs sf-dim"
          Text="{Binding StatusMessage}" />
        <StackPanel
          Grid.Column="1"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="10">
          <TextBlock
            VerticalAlignment="Center"
            Classes="sf-xs"
            Foreground="{DynamicResource SfAccentStrongBrush}"
            IsVisible="{Binding IsRecomputing}"
            Text="{x:Static lang:Resources.Venue_Recomputing}" />
          <TextBlock
            VerticalAlignment="Center"
            Classes="sf-xs sf-num sf-dim"
            Text="{Binding PreviewSeatCountDisplay}" />
        </StackPanel>
      </Grid>
    </Border>

    <!--  ═══════════════ 主体：会场列表 + 编辑器  ═══════════════  -->
    <Grid ColumnDefinitions="240,*">
      <!--  左侧：会场列表  -->
      <Border
        Grid.Column="0"
        Margin="16,12,8,12"
        Classes="sf-panel">
        <DockPanel>
          <TextBlock
            Margin="12,10,12,8"
            Classes="sf-h3"
            DockPanel.Dock="Top"
            Text="{x:Static lang:Resources.Venue_List}" />
          <StackPanel
            Margin="12,8,12,12"
            DockPanel.Dock="Bottom"
            Spacing="6">
            <Button
              x:Name="NewVenueButton"
              Classes="sf-btn sf-primary sf-block"
              Command="{Binding NewVenueCommand}"
              ToolTip.Tip="{x:Static lang:Resources.Venue_New}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Add}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Venue_New}" />
              </StackPanel>
            </Button>
            <Button
              Classes="sf-btn sf-block"
              Command="{Binding LoadVenueListCommand}"
              ToolTip.Tip="{x:Static lang:Resources.Venue_Refresh}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Refresh}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <ListBox
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding VenueItems}"
            SelectedItem="{Binding SelectedVenueItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VenueItem">
                <TextBlock
                  Margin="4,6"
                  Classes="sf-sm"
                  Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!--  右侧：编辑器 / 空态  -->
      <Grid Grid.Column="1">
        <!--  空状态  -->
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          IsVisible="{Binding HasSelectedVenue, Converter={x:Static conv:BoolConverters.Negate}}">
          <fic:FluentIcon
            HorizontalAlignment="Center"
            FontSize="48"
            Foreground="{DynamicResource SfTextFaintBrush}"
            Icon="{x:Static ficEnum:Icon.Building}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-h2 sf-dim"
            Text="{x:Static lang:Resources.Venue_NoSelection}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-hint"
            Text="{x:Static lang:Resources.Venue_SelectHint}" />
        </StackPanel>

        <!--  编辑器  -->
        <ScrollViewer IsVisible="{Binding HasSelectedVenue}">
          <StackPanel Margin="8,12,16,12" Spacing="12">

            <!--  布局类型  -->
            <Border x:Name="LayoutTypePanel" Classes="sf-card">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_LayoutType}" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <RadioButton
                    Classes="sf-check"
                    Command="{Binding SelectLayoutTypeCommand}"
                    CommandParameter="Grid"
                    Content="{x:Static lang:Resources.Venue_GridType}"
                    GroupName="LayoutType"
                    IsChecked="{Binding IsGridSelected, Mode=OneWay}"
                    IsEnabled="{Binding CanChangeLayoutType}" />
                  <RadioButton
                    Classes="sf-check"
                    Command="{Binding SelectLayoutTypeCommand}"
                    CommandParameter="Polar"
                    Content="{x:Static lang:Resources.Venue_PolarType}"
                    GroupName="LayoutType"
                    IsChecked="{Binding IsPolarSelected, Mode=OneWay}"
                    IsEnabled="{Binding CanChangeLayoutType}" />
                  <RadioButton
                    Classes="sf-check"
                    Command="{Binding SelectLayoutTypeCommand}"
                    CommandParameter="Freeform"
                    Content="{x:Static lang:Resources.Venue_FreeformType}"
                    GroupName="LayoutType"
                    IsChecked="{Binding IsFreeformSelected, Mode=OneWay}"
                    IsEnabled="{Binding CanChangeLayoutType}" />
                </StackPanel>
                <TextBlock
                  Classes="sf-hint"
                  IsVisible="{Binding IsFreeformSelected}"
                  Text="{x:Static lang:Resources.Venue_FreeformHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!--  ═══ Grid：基础参数  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsGridSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_BasicParams}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_Rows}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="100"
                      Minimum="1"
                      PlaceholderText="{x:Static lang:Resources.Venue_RowsPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RowsTooltip}"
                      Value="{Binding GridRows, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_Cols}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="100"
                      Minimum="1"
                      PlaceholderText="{x:Static lang:Resources.Venue_ColsPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_ColsTooltip}"
                      Value="{Binding GridColumns, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_HSpacing}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="600"
                      Minimum="4"
                      PlaceholderText="{x:Static lang:Resources.Venue_HSpacingPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_HSpacingTooltip}"
                      Value="{Binding GridHorizontalSpacing, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_VSpacing}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="600"
                      Minimum="4"
                      PlaceholderText="{x:Static lang:Resources.Venue_VSpacingPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_VSpacingTooltip}"
                      Value="{Binding GridVerticalSpacing, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_OriginX}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="2000"
                      Minimum="0"
                      PlaceholderText="{x:Static lang:Resources.Venue_OriginXPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_OriginXTooltip}"
                      Value="{Binding GridOriginX, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_OriginY}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="2000"
                      Minimum="0"
                      PlaceholderText="{x:Static lang:Resources.Venue_OriginYPH}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_OriginYTooltip}"
                      Value="{Binding GridOriginY, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>

                <Border Classes="sf-divider" />

                <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_Optional}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_ColumnRowCounts}" />
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Venue_DefaultColumnRowCounts}"
                      Text="{Binding GridColumnRowCountsSpec, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_ColumnRowCountsTooltip}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_DisabledSeats}" />
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Venue_DisabledSeatsPH}"
                      Text="{Binding GridEmptyPositionsSpec, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_DisabledSeatsTooltip}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Grid：桌面配置  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsGridSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_DeskConfig}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_DeskSize}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="6"
                      Minimum="1"
                      PlaceholderText="2"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_DeskSizeTooltip}"
                      Value="{Binding GridSeatsPerDesk, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_DeskInnerSpacing}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="200"
                      Minimum="4"
                      PlaceholderText="12 px"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_DeskInnerSpacingTooltip}"
                      Value="{Binding GridIntraDeskSpacing, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_DeskSpacing}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="400"
                      Minimum="4"
                      PlaceholderText="32 px"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_DeskSpacingTooltip}"
                      Value="{Binding GridInterDeskSpacing, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Grid：过道配置  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsGridSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_AisleConfig}" />
                <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_ColumnAisles}" />
                <ItemsControl ItemsSource="{Binding AisleColumnOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AisleOption">
                      <CheckBox
                        Margin="0,0,12,4"
                        Classes="sf-check"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip.Tip="{x:Static lang:Resources.Venue_AisleCheckTooltip}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                  Margin="0,4,0,0"
                  Classes="sf-hint"
                  Text="{x:Static lang:Resources.Venue_RowAisles}" />
                <ItemsControl ItemsSource="{Binding AisleRowOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AisleOption">
                      <CheckBox
                        Margin="0,0,12,4"
                        Classes="sf-check"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        ToolTip.Tip="{x:Static lang:Resources.Venue_AisleCheckTooltip}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel
                  Classes="sf-field"
                  Margin="0,4,0,0"
                  HorizontalAlignment="Left">
                  <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_AisleWidth}" />
                  <NumericUpDown
                    Classes="sf-input"
                    Maximum="300"
                    Minimum="12"
                    PlaceholderText="60 px"
                    ToolTip.Tip="{x:Static lang:Resources.Venue_AisleWidthTooltip}"
                    Value="{Binding GridAisleWidth, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Grid：教室特征  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsGridSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_ClassroomFeatures}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_FrontRows}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="10"
                      Minimum="1"
                      PlaceholderText="1"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_FrontRowsTooltip}"
                      Value="{Binding GridFrontRowCount, Mode=TwoWay}" />
                  </StackPanel>
                  <CheckBox
                    Margin="0,18,16,8"
                    Classes="sf-check"
                    Content="{x:Static lang:Resources.Venue_HasPodium}"
                    IsChecked="{Binding GridHasPodium, Mode=TwoWay}"
                    ToolTip.Tip="{x:Static lang:Resources.Venue_HasPodiumTooltip}" />
                  <StackPanel Classes="sf-field" IsVisible="{Binding GridHasPodium}">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_PodiumWidth}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="400"
                      Minimum="20"
                      PlaceholderText="60 px"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PodiumWidthTooltip}"
                      Value="{Binding GridPodiumWidth, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field" IsVisible="{Binding GridHasPodium}">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_PodiumHeight}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="200"
                      Minimum="20"
                      PlaceholderText="40 px"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PodiumHeightTooltip}"
                      Value="{Binding GridPodiumHeight, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Polar：基础参数  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsPolarSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_BasicParams}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_Rings}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="20"
                      Minimum="1"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RingsTooltip}"
                      Value="{Binding PolarRings, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_SeatsPerRing}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="120"
                      Minimum="2"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_SeatsPerRingTooltip}"
                      Value="{Binding PolarSeatsPerRing, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RadiusStep}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="400"
                      Minimum="8"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RadiusStepTooltip}"
                      Value="{Binding PolarRadiusStep, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_StartAngle}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="360"
                      Minimum="0"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_StartAngleTooltip}"
                      Value="{Binding PolarStartAngle, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_EndAngle}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="360"
                      Minimum="10"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_EndAngleTooltip}"
                      Value="{Binding PolarEndAngle, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_OriginX}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="2000"
                      Minimum="0"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PolarOriginXTooltip}"
                      Value="{Binding PolarOriginX, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_OriginY}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="2000"
                      Minimum="0"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PolarOriginYTooltip}"
                      Value="{Binding PolarOriginY, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RingSeats}" />
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Venue_RingSeatsPH}"
                      Text="{Binding PolarRingSeatCountsSpec, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RingSeatsTooltip}" />
                  </StackPanel>
                </WrapPanel>

                <Border Classes="sf-divider" />

                <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_Optional}" />
                <StackPanel Classes="sf-field">
                  <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_DisabledSeats}" />
                  <TextBox
                    Classes="sf-input"
                    PlaceholderText="{x:Static lang:Resources.Venue_PolarDisabledPH}"
                    Text="{Binding PolarEmptyPositionsSpec, Mode=TwoWay}"
                    ToolTip.Tip="{x:Static lang:Resources.Venue_PolarDisabledTooltip}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Polar：教室特征  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsPolarSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_ClassroomFeatures}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_FrontRows}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="10"
                      Minimum="1"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PolarFrontRowsTooltip}"
                      Value="{Binding PolarFrontRowCount, Mode=TwoWay}" />
                  </StackPanel>
                  <CheckBox
                    Margin="0,18,16,8"
                    Classes="sf-check"
                    Content="{x:Static lang:Resources.Venue_HasPodium}"
                    IsChecked="{Binding PolarHasPodium, Mode=TwoWay}" />
                  <StackPanel Classes="sf-field" IsVisible="{Binding PolarHasPodium}">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_PodiumRadius}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="200"
                      Minimum="10"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_PodiumRadiusTooltip}"
                      Value="{Binding PolarPodiumRadius, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--  ═══ Polar：通道配置  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsPolarSelected}">
              <StackPanel Spacing="8">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_ChannelConfig}" />
                <WrapPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RadialAisleAngles}" />
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Venue_RadialAislePH}"
                      Text="{Binding PolarAisleRadialAngles, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RadialAisleAnglesTooltip}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RadialAisleWidth}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="30"
                      Minimum="1"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RadialAisleWidthTooltip}"
                      Value="{Binding PolarAisleRadialWidth, Mode=TwoWay}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RingAislePositions}" />
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Venue_RingAislePH}"
                      Text="{Binding PolarAisleCircularRings, Mode=TwoWay}"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RingAislePositionsTooltip}" />
                  </StackPanel>
                  <StackPanel Classes="sf-field">
                    <TextBlock Classes="sf-hint" Text="{x:Static lang:Resources.Venue_RingAisleWidth}" />
                    <NumericUpDown
                      Classes="sf-input"
                      Maximum="200"
                      Minimum="4"
                      ToolTip.Tip="{x:Static lang:Resources.Venue_RingAisleWidthTooltip}"
                      Value="{Binding PolarAisleCircularWidth, Mode=TwoWay}" />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!--  ═══ 门配置（Grid + Polar 共用；Freeform 的门在坐标表中维护）  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsDoorPanelVisible}">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-h3"
                    Text="{x:Static lang:Resources.Venue_DoorSection}" />
                  <Button
                    Classes="sf-btn sf-sm"
                    Command="{Binding AddDoorCommand}"
                    ToolTip.Tip="{x:Static lang:Resources.Venue_AddDoorTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Add}" />
                      <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Venue_AddDoor}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DoorItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DoorItem">
                      <Border
                        Padding="0,4"
                        BorderBrush="{DynamicResource SfBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                          <TextBlock
                            VerticalAlignment="Center"
                            Classes="sf-xs sf-dim"
                            Text="{Binding Label}" />
                          <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                              VerticalAlignment="Center"
                              Classes="sf-xs sf-dim"
                              Text="X :" />
                            <NumericUpDown
                              Width="120"
                              Classes="sf-input"
                              Maximum="2000"
                              Minimum="0"
                              ToolTip.Tip="{x:Static lang:Resources.Venue_DoorXTooltip}"
                              Value="{Binding X, Mode=TwoWay}" />
                            <TextBlock
                              VerticalAlignment="Center"
                              Classes="sf-xs sf-dim"
                              Text="Y :" />
                            <NumericUpDown
                              Width="120"
                              Classes="sf-input"
                              Maximum="2000"
                              Minimum="0"
                              ToolTip.Tip="{x:Static lang:Resources.Venue_DoorYTooltip}"
                              Value="{Binding Y, Mode=TwoWay}" />
                          </StackPanel>
                          <Button
                            Grid.Column="2"
                            Classes="sf-btn sf-sm sf-icon"
                            Command="{Binding $parent[UserControl].DataContext.RemoveDoorCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{x:Static lang:Resources.Common_Delete}">
                            <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Delete}" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!--  ═══ Freeform：坐标表  ═══  -->
            <Border Classes="sf-card" IsVisible="{Binding IsFreeformSelected}">
              <DockPanel>
                <Grid
                  Margin="0,0,0,8"
                  ColumnDefinitions="*,Auto"
                  DockPanel.Dock="Top">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_Coordinates}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-xs sf-num sf-dim"
                      Text="{Binding ElementCountDisplay}" />
                  </StackPanel>
                  <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                      Classes="sf-btn sf-sm"
                      Command="{Binding ExportTemplateCommand}"
                      ToolTip.Tip="{x:Static lang:Resources.Data_ExportTemplate}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Document}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_Template}" />
                      </StackPanel>
                    </Button>
                    <Button
                      x:Name="ImportCsvButton"
                      Classes="sf-btn sf-sm"
                      Command="{Binding ImportCsvCommand}"
                      ToolTip.Tip="{x:Static lang:Resources.Freeform_ImportCSV}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.ArrowDownload}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_ImportCSV}" />
                      </StackPanel>
                    </Button>
                    <Button
                      Classes="sf-btn sf-sm"
                      Command="{Binding ImportJsonCommand}"
                      ToolTip.Tip="{x:Static lang:Resources.Freeform_ImportJSON}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.ArrowDownload}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_ImportJSON}" />
                      </StackPanel>
                    </Button>
                    <Button
                      x:Name="AddPointButton"
                      Classes="sf-btn sf-sm"
                      Command="{Binding AddPointCommand}"
                      ToolTip.Tip="{x:Static lang:Resources.Freeform_AddPoint}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Add}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_AddPoint}" />
                      </StackPanel>
                    </Button>
                    <Button
                      Classes="sf-btn sf-sm"
                      Command="{Binding ClearPointsCommand}"
                      IsEnabled="{Binding HasPoints}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Delete}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_ClearData}" />
                      </StackPanel>
                    </Button>
                    <Button
                      Classes="sf-btn sf-sm"
                      Command="{Binding UnloadCommand}"
                      IsEnabled="{Binding HasPoints}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.UninstallApp}" />
                        <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Freeform_Unload}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <TextBlock
                  Margin="0,0,0,8"
                  Classes="sf-hint"
                  DockPanel.Dock="Top"
                  IsVisible="{Binding IsFreeformEmptyState}"
                  Text="{x:Static lang:Resources.Freeform_NoDataHint}"
                  TextWrapping="Wrap" />

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <StackPanel MinWidth="760">
                    <!--  表头  -->
                    <Grid
                      Margin="4,0,4,4"
                      ColumnDefinitions="32,110,110,110,90,90,80,36"
                      ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Classes="sf-xs sf-faint" Text="#" />
                      <TextBlock Grid.Column="1" Classes="sf-xs sf-faint" Text="X" />
                      <TextBlock Grid.Column="2" Classes="sf-xs sf-faint" Text="Y" />
                      <TextBlock Grid.Column="3" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Freeform_Type}" />
                      <TextBlock Grid.Column="4" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Freeform_RowLabel}" />
                      <TextBlock Grid.Column="5" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Freeform_ColLabel}" />
                      <TextBlock Grid.Column="6" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Freeform_GroupLabel}" />
                      <TextBlock Grid.Column="7" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Common_Delete}" />
                    </Grid>
                    <Border Classes="sf-divider" />
                    <ListBox
                      MaxHeight="360"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding Points}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FreeformPoint">
                          <Grid
                            Margin="0,1"
                            ColumnDefinitions="32,110,110,110,90,90,80,36"
                            ColumnSpacing="8">
                            <TextBlock
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              Classes="sf-xs sf-num sf-dim"
                              Text="{Binding DisplayIndex, StringFormat={}{0}.}" />
                            <NumericUpDown
                              Grid.Column="1"
                              Classes="sf-input"
                              Maximum="5000"
                              Minimum="0"
                              PlaceholderText="{x:Static lang:Resources.Freeform_XCoord}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_XTooltip}"
                              Value="{Binding X, Mode=TwoWay}" />
                            <NumericUpDown
                              Grid.Column="2"
                              Classes="sf-input"
                              Maximum="5000"
                              Minimum="0"
                              PlaceholderText="{x:Static lang:Resources.Freeform_YCoord}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_YTooltip}"
                              Value="{Binding Y, Mode=TwoWay}" />
                            <ComboBox
                              Grid.Column="3"
                              Classes="sf-input"
                              SelectedIndex="{Binding ElementType, Mode=TwoWay}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_TypeTooltip}">
                              <ComboBoxItem Content="{x:Static lang:Resources.Freeform_Seat}" />
                              <ComboBoxItem Content="{x:Static lang:Resources.Freeform_Podium}" />
                              <ComboBoxItem Content="{x:Static lang:Resources.Freeform_Door}" />
                            </ComboBox>
                            <NumericUpDown
                              Grid.Column="4"
                              Classes="sf-input"
                              Maximum="100"
                              Minimum="0"
                              PlaceholderText="{x:Static lang:Resources.Freeform_RowPH}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_RowPH}"
                              Value="{Binding Row, Mode=TwoWay}" />
                            <NumericUpDown
                              Grid.Column="5"
                              Classes="sf-input"
                              Maximum="100"
                              Minimum="0"
                              PlaceholderText="{x:Static lang:Resources.Freeform_ColPH}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_ColPH}"
                              Value="{Binding Column, Mode=TwoWay}" />
                            <NumericUpDown
                              Grid.Column="6"
                              Classes="sf-input"
                              Maximum="7"
                              Minimum="0"
                              PlaceholderText="{x:Static lang:Resources.Freeform_GroupPH}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_GroupTooltip}"
                              Value="{Binding GroupId, Mode=TwoWay}" />
                            <Button
                              Grid.Column="7"
                              Classes="sf-btn sf-sm sf-icon"
                              Command="{Binding $parent[UserControl].DataContext.DeletePointCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="{x:Static lang:Resources.Freeform_DeletePoint}">
                              <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.Delete}" />
                            </Button>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!--  ═══ 预览（自绘 SeatingCanvas）  ═══  -->
            <Border Classes="sf-card">
              <DockPanel>
                <Grid
                  Margin="0,0,0,8"
                  ColumnDefinitions="*,Auto"
                  DockPanel.Dock="Top">
                  <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Venue_Preview}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Venue_DragHint}" />
                  </StackPanel>
                  <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="sf-xs sf-num sf-dim"
                    Text="{Binding PreviewSeatCountDisplay}" />
                </Grid>
                <Border
                  Height="380"
                  Padding="0"
                  Classes="sf-inset"
                  ClipToBounds="True">
                  <controls:SeatingCanvas Snapshot="{Binding PreviewSnapshot}" />
                </Border>
              </DockPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
