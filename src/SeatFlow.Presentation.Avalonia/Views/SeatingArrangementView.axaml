<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SeatingArrangementView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:behaviors="using:SeatFlow.Presentation.Avalonia.Behaviors"
  xmlns:conv="using:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:core="using:SeatFlow.Core.Models"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SeatingArrangementViewModel">

  <DockPanel Classes="pageMargin">
    <!--  ═══ 工具栏 ═══  -->
    <Border Classes="sectionSpacing" DockPanel.Dock="Top">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Classes="pageTitle"
          DockPanel.Dock="Left"
          Text="{x:Static lang:Resources.Seating_Title}" />
        <StackPanel
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="8">
          <!--  导出按钮 + Flyout  -->
          <Button
            x:Name="ExportButton"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Data_Export}"
            IsEnabled="{Binding HasGenerated}">
            <Button.Flyout>
              <MenuFlyout>
                <!--  学生视角  -->
                <MenuItem
                  Classes="sectionTitle"
                  Foreground="{DynamicResource SystemAccentColor}"
                  IsEnabled="False">
                  <MenuItem.Header>
                    <TextBlock Text="{x:Static lang:Resources.Seating_StudentView}" />
                  </MenuItem.Header>
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Person}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportExcelCommand}" Header="Excel (.xlsx)">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentTableCube}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportCsvCommand}" Header="CSV (.csv)">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentTable}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportPdfCommand}" Header="PDF (.pdf)">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentPdf}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportImageCommand}" Header="{x:Static lang:Resources.Seating_ExportPNG}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Image}" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!--  教师视角  -->
                <MenuItem
                  Classes="sectionTitle"
                  Foreground="{DynamicResource SystemAccentColor}"
                  IsEnabled="False">
                  <MenuItem.Header>
                    <TextBlock Text="{x:Static lang:Resources.Seating_TeacherView}" />
                  </MenuItem.Header>
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.PeopleTeamToolbox}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportTeacherExcelCommand}" Header="Excel (.xlsx)">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentTableCube}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding ExportTeacherCsvCommand}" Header="CSV (.csv)">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentTable}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding ExportTeacherPdfCommand}"
                  Header="PDF (.pdf)"
                  IsVisible="{Binding !IsWebPlatform}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.DocumentPdf}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding ExportTeacherImageCommand}"
                  Header="{x:Static lang:Resources.Seating_ExportPNG}"
                  IsVisible="{Binding !IsWebPlatform}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Image}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.SaveArrowRight}" />
              <TextBlock Classes="body" Text="{x:Static lang:Resources.Seating_Export}" />
            </StackPanel>
          </Button>
          <!--  保存到快照  -->
          <Button
            x:Name="SaveSnapshotButton"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Seating_SaveSnapshot}"
            Command="{Binding SaveToSnapshotCommand}"
            IsEnabled="{Binding HasUnsavedChanges}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock Classes="body" Text="{x:Static lang:Resources.Common_Save}" />
            </StackPanel>
          </Button>
          <!--  撤销  -->
          <Button
            x:Name="UndoButton"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Seating_UndoSwap}"
            Command="{Binding UndoCommand}"
            IsEnabled="{Binding CanUndo}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
              <TextBlock Classes="body" Text="{x:Static lang:Resources.Seating_Undo}" />
            </StackPanel>
          </Button>
          <!--  重做  -->
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Seating_RedoSwap}"
            Command="{Binding RedoCommand}"
            IsEnabled="{Binding CanRedo}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.ArrowRedo}" />
              <TextBlock Classes="body" Text="{x:Static lang:Resources.Seating_Redo}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══ 状态栏 ═══  -->
    <Border
      Classes="statusBarBottom"
      DockPanel.Dock="Bottom"
      IsVisible="{Binding HasGenerated}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Classes="caption"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          Text="{Binding StatusMessage}" />
        <StackPanel
          Grid.Column="1"
          Orientation="Horizontal"
          Spacing="16">
          <TextBlock Classes="caption">
            <Run Text="{x:Static lang:Resources.Seating_Seats}" />
            <Run Text="{Binding AssignedSeats}" />
            <Run Text="/" />
            <Run Text="{Binding TotalSeats}" />
          </TextBlock>
          <TextBlock Classes="caption">
            <Run Text="{x:Static lang:Resources.Seating_Unassigned}" />
            <Run Text="{Binding UnassignedStudentCount}" />
            <Run Text="{x:Static lang:Resources.Seating_People}" />
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <!--  交换提示栏  -->
    <Border
      Classes="statusBarBottom"
      DockPanel.Dock="Bottom"
      IsVisible="{Binding IsSwapMode}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          VerticalAlignment="Center"
          Classes="caption"
          Foreground="{DynamicResource SystemAccentColor}"
          Text="{Binding SwapHintText}" />
        <Button
          Grid.Column="1"
          Padding="8,2"
          AutomationProperties.Name="{x:Static lang:Resources.Seating_CancelSwap}"
          Command="{Binding CancelSwapCommand}"
          FontSize="12">
          <TextBlock Text="{x:Static lang:Resources.Common_Cancel}" />
        </Button>
      </Grid>
    </Border>

    <!--  ═══ 三栏内容区 ═══  -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!--  ─── 左侧面板 ───  -->
      <Border
        Grid.Column="0"
        Margin="0,0,8,0"
        Background="{DynamicResource SidebarBackgroundBrush}"
        ClipToBounds="True"
        CornerRadius="6">
        <Grid Margin="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
          <!--  会场选择  -->
          <TextBlock
            Grid.Row="0"
            Margin="3,0,0,8"
            Classes="sectionTitle"
            Text="{x:Static lang:Resources.Seating_Venue}" />
          <ListBox
            x:Name="VenueListBox"
            Grid.Row="1"
            MaxHeight="180"
            AutomationProperties.Name="{x:Static lang:Resources.Venue_List}"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderThickness="0"
            ItemsSource="{Binding VenueItems}"
            SelectedItem="{Binding SelectedVenue, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VenueItem">
                <TextBlock
                  Margin="4,6"
                  Classes="bodySmall"
                  Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Separator Grid.Row="2" Margin="4,10" />

          <!--  数据集选择  -->
          <TextBlock
            Grid.Row="3"
            Margin="3,0,0,8"
            Classes="sectionTitle"
            Text="{x:Static lang:Resources.Seating_MemberData}" />
          <ListBox
            x:Name="DatasetListBox"
            Grid.Row="4"
            MaxHeight="180"
            AutomationProperties.Name="{x:Static lang:Resources.Seating_MemberDatasetList}"
            Background="{DynamicResource SidebarBackgroundBrush}"
            BorderThickness="0"
            ItemsSource="{Binding DatasetItems}"
            SelectedItem="{Binding SelectedDataset, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="core:StudentDatasetInfo">
                <TextBlock
                  Margin="4,6"
                  Classes="bodySmall"
                  Text="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!--  填充 spacer  -->
          <Panel Grid.Row="5" />

          <!--  生成 + 创建空白会场按钮  -->
          <DockPanel Grid.Row="6" Margin="0,8">
            <Button
              Width="36"
              Height="36"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              AutomationProperties.Name="{x:Static lang:Resources.Seating_CreateEmpty}"
              Command="{Binding CreateEmptySeatingCommand}"
              DockPanel.Dock="Right"
              IsEnabled="{Binding CanCreateEmpty}"
              ToolTip.Tip="{x:Static lang:Resources.Seating_CreateEmpty}">
              <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.TableAdd}" />
            </Button>
            <Button
              x:Name="GenerateButton"
              Height="36"
              Margin="0,0,4,0"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              AutomationProperties.Name="{x:Static lang:Resources.Seating_Title}"
              Classes="accent"
              Command="{Binding GenerateSeatingCommand}"
              IsEnabled="{Binding CanGenerate}">
              <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Seating_Generate}" />
              </StackPanel>
            </Button>
          </DockPanel>
        </Grid>
      </Border>

      <!--  GridSplitter  -->
      <GridSplitter
        Grid.Column="1"
        Width="4"
        HorizontalAlignment="Stretch"
        Background="Transparent" />

      <!--  ─── 中央 Canvas + 右侧面板 ───  -->
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  ═══ 座位图 Canvas ═══  -->
        <Border
          Grid.Column="0"
          Padding="0"
          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
          ClipToBounds="True"
          CornerRadius="6">
          <Panel>

            <!--  空状态  -->
            <Border
              Padding="40"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              IsVisible="{Binding HasGenerated, Converter={x:Static conv:BoolConverters.Negate}}">
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <fic:FluentIcon
                  HorizontalAlignment="Center"
                  FontSize="48"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Icon="{x:Static ficEnum:Icon.Grid}" />
                <TextBlock
                  HorizontalAlignment="Center"
                  Classes="sectionTitle"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Seating_NotGenerated}" />
                <TextBlock
                  HorizontalAlignment="Center"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Seating_NotGeneratedHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!--  座位渲染区  -->
            <ScrollViewer
              x:Name="PreviewScrollViewer"
              behaviors:CanvasZoomPan.Enabled="True"
              behaviors:ZoomOnScroll.Enabled="True"
              behaviors:ZoomOnScroll.OnZoom="{Binding ZoomAction}"
              Background="{DynamicResource PreviewBackgroundBrush}"
              HorizontalScrollBarVisibility="Auto"
              IsVisible="{Binding HasGenerated}"
              VerticalScrollBarVisibility="Auto">
              <Panel>
                <ItemsControl ItemsSource="{Binding SeatItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas Width="{Binding $parent[UserControl].DataContext.CanvasWidth, Mode=OneWay}" Height="{Binding $parent[UserControl].DataContext.CanvasHeight, Mode=OneWay}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                      <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeatDisplayItem">
                      <Border
                        Width="{ReflectionBinding Width}"
                        Height="{ReflectionBinding Height}"
                        Background="{ReflectionBinding BackgroundBrush}"
                        BorderBrush="{ReflectionBinding BorderBrush}"
                        BorderThickness="2"
                        CornerRadius="{ReflectionBinding CornerRadius}"
                        Cursor="Hand"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragLeave="Seat_DragLeave"
                        DragDrop.DragOver="Seat_DragOver"
                        DragDrop.Drop="Seat_Drop"
                        PointerPressed="SeatBorder_PointerPressed"
                        ToolTip.Tip="{ReflectionBinding TooltipText}">
                        <TextBlock
                          Margin="2,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          FontSize="11"
                          FontWeight="SemiBold"
                          Text="{ReflectionBinding DisplayText}"
                          TextWrapping="NoWrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding OverlayItems}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <Canvas Width="{Binding $parent[UserControl].DataContext.CanvasWidth, Mode=OneWay}" Height="{Binding $parent[UserControl].DataContext.CanvasHeight, Mode=OneWay}" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.Styles>
                    <Style Selector="ItemsControl &gt; ContentPresenter">
                      <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                      <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeatDisplayItem">
                      <Border
                        Width="{ReflectionBinding Width}"
                        Height="{ReflectionBinding Height}"
                        Background="{ReflectionBinding BackgroundBrush}"
                        BorderBrush="{ReflectionBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ReflectionBinding CornerRadius}"
                        ToolTip.Tip="{ReflectionBinding TooltipText}">
                        <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Classes="micro"
                          Text="{ReflectionBinding DisplayText}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </ScrollViewer>
            <!--  垃圾桶：拖入或点击移除学生  -->
            <Border
              Name="TrashZone"
              Width="44"
              Height="44"
              Margin="0,0,12,36"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              AutomationProperties.Name="{x:Static lang:Resources.Seating_TrashHint}"
              Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="2"
              CornerRadius="22"
              Cursor="Hand"
              DragDrop.AllowDrop="True"
              DragDrop.DragLeave="Trash_DragLeave"
              DragDrop.DragOver="Trash_DragOver"
              DragDrop.Drop="Trash_Drop"
              IsVisible="{Binding HasGenerated}"
              PointerPressed="Trash_PointerPressed"
              ToolTip.Tip="{x:Static lang:Resources.Seating_TrashHint}"
              ZIndex="10">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="22"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Icon="{x:Static ficEnum:Icon.Delete}" />
            </Border>
            <TextBlock
              Margin="0,0,12,8"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Classes="small"
              IsVisible="{Binding HasGenerated}"
              Opacity="0.4"
              Text="{x:Static lang:Resources.Seating_CanvasHint}" />
          </Panel>
        </Border>

        <!--  ═══ 右侧面板 ═══  -->
        <Border
          Grid.Column="1"
          Width="240"
          Margin="8,0,0,0"
          Padding="8"
          Background="{DynamicResource SidebarBackgroundBrush}"
          CornerRadius="6"
          IsVisible="{Binding HasGenerated}">
          <ScrollViewer>
            <StackPanel Spacing="8">
              <!--  ── 策略列表 (可折叠) ──  -->
              <StackPanel>
                <Button
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  Command="{Binding ToggleStrategiesCommand}"
                  Cursor="Hand">
                  <DockPanel>
                    <TextBlock
                      Classes="sectionTitle"
                      DockPanel.Dock="Left"
                      Text="{x:Static lang:Resources.Seating_CurrentStrategy}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronUp}"
                      IsVisible="{Binding IsStrategiesExpanded}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronDown}"
                      IsVisible="{Binding IsStrategiesExpanded, Converter={x:Static conv:BoolConverters.Negate}}" />
                  </DockPanel>
                </Button>
                <ItemsControl
                  MaxHeight="200"
                  IsVisible="{Binding IsStrategiesExpanded}"
                  ItemsSource="{Binding ActiveStrategies}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:StrategyDisplayInfo">
                      <StackPanel>
                        <!--  父策略项：有子项时左侧竖线  -->
                        <DockPanel Margin="4,3">
                          <Border
                            Width="4"
                            Margin="0,2,4,2"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource SystemAccentColor}"
                            CornerRadius="2"
                            DockPanel.Dock="Left"
                            IsVisible="{Binding HasDependentChildren}" />
                          <Border
                            Margin="0,0,8,0"
                            Padding="4,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SystemAccentColor}"
                            CornerRadius="3">
                            <TextBlock
                              Classes="micro"
                              Foreground="White"
                              Text="{Binding Priority}" />
                          </Border>
                          <StackPanel>
                            <TextBlock Classes="bodySmall" Text="{Binding DisplayName}" />
                            <TextBlock
                              Classes="small"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Text="{Binding Category}" />
                          </StackPanel>
                        </DockPanel>
                        <!--  依赖策略子项：平级，左侧竖线区分  -->
                        <ItemsControl ItemsSource="{Binding DependentChildren}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:StrategyDisplayInfo">
                              <DockPanel Margin="4,1">
                                <Border
                                  Width="4"
                                  Margin="0,2,4,2"
                                  VerticalAlignment="Stretch"
                                  Background="{DynamicResource SystemAccentColor}"
                                  CornerRadius="2"
                                  DockPanel.Dock="Left" />
                                <Border
                                  Margin="0,0,8,0"
                                  Padding="4,1"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource SystemAccentColor}"
                                  CornerRadius="3">
                                  <TextBlock
                                    Classes="micro"
                                    Foreground="White"
                                    Text="{Binding Priority}" />
                                </Border>
                                <StackPanel>
                                  <TextBlock Classes="bodySmall" Text="{Binding DisplayName}" />
                                  <TextBlock
                                    Classes="small"
                                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                    Text="{Binding Category}" />
                                </StackPanel>
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Separator />

              <!--  ── 未分配学生 (可折叠) ──  -->
              <StackPanel>
                <Button
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  Command="{Binding ToggleUnassignedCommand}"
                  Cursor="Hand">
                  <DockPanel>
                    <TextBlock Classes="bodyStrong" DockPanel.Dock="Left">
                      <Run Text="{x:Static lang:Resources.Seating_UnassignedMembers}" />
                      <!--  Run 不是 StyledElement，Typography 样式类（TextBlock.* 选择器）无法匹配，只能用内联 FontSize  -->
                      <Run
                        FontSize="12"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="{Binding UnassignedStudentCount, StringFormat=' ({0})'}" />
                    </TextBlock>
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronUp}"
                      IsVisible="{Binding IsUnassignedExpanded}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronDown}"
                      IsVisible="{Binding IsUnassignedExpanded, Converter={x:Static conv:BoolConverters.Negate}}" />
                  </DockPanel>
                </Button>
                <ListBox
                  AutomationProperties.Name="{x:Static lang:Resources.Seating_UnassignedMembers}"
                  Background="{DynamicResource SidebarBackgroundBrush}"
                  BorderThickness="0"
                  IsVisible="{Binding IsUnassignedExpanded}"
                  ItemsSource="{Binding UnassignedStudents}"
                  SelectedItem="{Binding SelectedUnassignedStudent, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:Student">
                      <Border
                        Padding="4"
                        Background="Transparent"
                        PointerPressed="UnassignedStudent_PointerPressed">
                        <TextBlock Classes="bodySmall" Text="{Binding Name}" />
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <Separator IsVisible="{Binding HasHistory}" />

              <!--  ── 修改记录 (可折叠) ──  -->
              <StackPanel IsVisible="{Binding HasHistory}">
                <DockPanel Margin="0,0,0,4">
                  <Button
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ToggleHistoryCommand}"
                    Cursor="Hand"
                    DockPanel.Dock="Left">
                    <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Seating_History}" />
                  </Button>
                  <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    Spacing="4">
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronUp}"
                      IsVisible="{Binding IsHistoryExpanded}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronDown}"
                      IsVisible="{Binding IsHistoryExpanded, Converter={x:Static conv:BoolConverters.Negate}}" />
                    <Button
                      Padding="8,4"
                      HorizontalContentAlignment="Center"
                      Command="{Binding RestoreToSelectedCommand}"
                      IsEnabled="{Binding HasSelectedHistory}">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
                        <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Seating_Restore}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DockPanel>
                <ListBox
                  MaxHeight="220"
                  Background="{DynamicResource SidebarBackgroundBrush}"
                  BorderThickness="0"
                  IsVisible="{Binding IsHistoryExpanded}"
                  ItemsSource="{Binding HistoryEntries}"
                  SelectedItem="{Binding SelectedHistory, Mode=TwoWay}">
                  <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                      <Setter Property="Padding" Value="6,3" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ Border#PART_BackgroundBorder">
                      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2}" />
                      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Setter Property="CornerRadius" Value="4" />
                    </Style>
                  </ListBox.Styles>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryEntry">
                      <StackPanel Margin="0,2">
                        <TextBlock
                          Classes="bodySmall"
                          FontWeight="{Binding IsCurrent, Converter={x:Static conv:BoolConverters.TrueToBold}}"
                          Text="{Binding Description}" />
                        <TextBlock
                          Classes="micro"
                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                          Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>

              <Separator IsVisible="{Binding HasMessages}" />

              <!--  ── 策略消息 (可折叠) ──  -->
              <StackPanel IsVisible="{Binding HasMessages}">
                <Button
                  Padding="0"
                  HorizontalContentAlignment="Stretch"
                  Background="Transparent"
                  BorderThickness="0"
                  Command="{Binding ToggleMessagesCommand}"
                  Cursor="Hand">
                  <DockPanel>
                    <TextBlock
                      Classes="sectionTitle"
                      DockPanel.Dock="Left"
                      Text="{x:Static lang:Resources.Seating_StrategyMessages}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronUp}"
                      IsVisible="{Binding IsMessagesExpanded}" />
                    <fic:FluentIcon
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      FontSize="14"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Icon="{x:Static ficEnum:Icon.ChevronDown}"
                      IsVisible="{Binding IsMessagesExpanded, Converter={x:Static conv:BoolConverters.Negate}}" />
                  </DockPanel>
                </Button>
                <ScrollViewer MaxHeight="300" IsVisible="{Binding IsMessagesExpanded}">
                  <ItemsControl ItemsSource="{Binding MessageGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:StrategyMessageGroup">
                        <StackPanel Margin="0,4">
                          <!--  分组标题：错误 (n) / 警告 (n)  -->
                          <TextBlock
                            Margin="4,2,0,4"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Title}" />
                          <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:StrategyMessageItem">
                                <Border
                                  Margin="4,1"
                                  Padding="6,4"
                                  Background="{DynamicResource SystemControlBackgroundSubtleBrush}"
                                  CornerRadius="4">
                                  <StackPanel Spacing="2">
                                    <TextBlock
                                      FontSize="10"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource SystemAccentColor}"
                                      Text="{Binding StrategyName}" />
                                    <TextBlock
                                      Classes="small"
                                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                      Text="{Binding Message}"
                                      TextWrapping="Wrap" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>

      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
