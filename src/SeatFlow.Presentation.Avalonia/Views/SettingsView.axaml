<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SettingsView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SettingsViewModel">

  <Design.DataContext>
    <vm:SettingsViewModel />
  </Design.DataContext>

  <DockPanel Classes="pageMargin">
    <!--  顶部标题栏  -->
    <Border Margin="0,0,0,24" DockPanel.Dock="Top">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Classes="pageTitle"
          DockPanel.Dock="Left"
          Text="{x:Static lang:Resources.Settings_Title}" />
        <StackPanel
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="8">
          <Button
            x:Name="SaveSettingsButton"
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Settings_Save}"
            Command="{Binding SaveSettingsCommand}"
            IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_Save}" />
            </StackPanel>
          </Button>
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Settings_ResetDefaults}"
            Command="{Binding ResetDefaultsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_ResetDefaults}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  底部状态栏  -->
    <Border Padding="0,8,0,0" DockPanel.Dock="Bottom">
      <StackPanel>
        <Separator Margin="0,0,0,8" />
        <TextBlock
          Classes="caption"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          Text="{Binding StatusMessage}" />
      </StackPanel>
    </Border>

    <!--  内容区：卡片布局  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel
        MaxWidth="680"
        Margin="0,0,0,32"
        Spacing="16">

        <!--  ═══ 外观卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.PaintBrush}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Appearance}" />
            </StackPanel>

            <Border Classes="settingRowInner">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="body"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.Settings_ThemeMode}" />
                <ComboBox
                  MinWidth="160"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_ThemeMode}"
                  FontSize="14"
                  ItemsSource="{Binding ThemeOptions}"
                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
              </DockPanel>
            </Border>

            <Border Classes="settingRowInner">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="body"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.Settings_DefaultZoom}" />
                <ComboBox
                  MinWidth="160"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_DefaultZoom}"
                  FontSize="14"
                  ItemsSource="{Binding ZoomOptions}"
                  SelectedIndex="{Binding ZoomIndex, Mode=TwoWay}" />
              </DockPanel>
            </Border>

            <DockPanel>
              <TextBlock
                VerticalAlignment="Center"
                Classes="body"
                DockPanel.Dock="Left"
                Text="{x:Static lang:Resources.Settings_LanguageLabel}" />
              <ComboBox
                MinWidth="180"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_LanguageLabel}"
                FontSize="14"
                ItemsSource="{Binding LanguageOptions}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Classes="body" Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 存储卡片（浏览器无文件系统路径，隐藏） ═══  -->
        <Border Classes="settingsCard" IsVisible="{Binding !IsWebPlatform}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Folder}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Storage}" />
            </StackPanel>

            <Border Classes="settingRowInner">
              <DockPanel>
                <TextBlock
                  Margin="0,4,0,0"
                  VerticalAlignment="Top"
                  Classes="body"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.Settings_DataDir}" />
                <StackPanel
                  MinWidth="280"
                  HorizontalAlignment="Right"
                  Spacing="6">
                  <DockPanel>
                    <Button
                      Padding="8,8"
                      AutomationProperties.Name="{x:Static lang:Resources.Settings_BrowseDataDir}"
                      Command="{Binding BrowseDataDirectoryCommand}"
                      DockPanel.Dock="Right">
                      <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Folder}" />
                    </Button>
                    <TextBox
                      FontSize="14"
                      PlaceholderText="{x:Static lang:Resources.Settings_DataDirPlaceholder}"
                      Text="{Binding DataDirectory, Mode=TwoWay}" />
                  </DockPanel>
                  <Button
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_OpenDataDir}"
                    Classes="linkButton"
                    Command="{Binding OpenDataDirectoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.ArrowUpload}" />
                      <TextBlock Classes="caption" Text="{x:Static lang:Resources.Settings_OpenDataDir}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DockPanel>
            </Border>

            <DockPanel>
              <TextBlock
                VerticalAlignment="Center"
                Classes="body"
                DockPanel.Dock="Left"
                Text="{x:Static lang:Resources.Settings_MaxSnapshots}" />
              <NumericUpDown
                Width="150"
                HorizontalAlignment="Right"
                Increment="1"
                Maximum="300"
                Minimum="0"
                Value="{Binding MaxSnapshotsPerVenue, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 行为卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Options}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Behavior}" />
            </StackPanel>

            <Border Classes="settingRowInner">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="body"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.Settings_ConfirmClear}" />
                <ToggleSwitch
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_ConfirmClear}"
                  IsChecked="{Binding ConfirmBeforeClear, Mode=TwoWay}" />
              </DockPanel>
            </Border>

            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_SuppressEnvWarning}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_SuppressEnvWarningHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_SuppressEnvWarning}"
                IsChecked="{Binding SuppressEnvironmentWarning, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 键盘快捷键卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel
              x:Name="KeyboardShortcutsSection"
              Orientation="Horizontal"
              Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Keyboard}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_KeyboardShortcuts}" />
            </StackPanel>

            <!--  Ctrl+Z 撤销  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Undo}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_UndoHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                x:Name="UndoShortcutSwitch"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Undo}"
                IsChecked="{Binding UndoShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>

            <!--  Ctrl+Y 重做  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Redo}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_RedoHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Redo}"
                IsChecked="{Binding RedoShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>

            <!--  Ctrl+S 保存  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Save}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_SaveHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Save}"
                IsChecked="{Binding SaveShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>

            <!--  Ctrl+滚轮 缩放  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Zoom}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_ZoomHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Zoom}"
                IsChecked="{Binding ZoomShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>

            <!--  Delete 删除  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Delete}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_DeleteHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Delete}"
                IsChecked="{Binding DeleteShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>

            <!--  Esc 取消  -->
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_KbShortcut_Escape}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_KbShortcut_EscapeHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ToggleSwitch
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Escape}"
                IsChecked="{Binding EscapeShortcutEnabled, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 日志卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Document}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Logging}" />
            </StackPanel>

            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="4">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_LogLevel}" />
                <TextBlock
                  MaxWidth="440"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_LogLevelHint}"
                  TextWrapping="Wrap" />
              </StackPanel>
              <ComboBox
                MinWidth="120"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_LogLevel}"
                FontSize="14"
                ItemsSource="{Binding LogLevelOptions}"
                SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}" />
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 隐私卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Shield}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Privacy}" />
            </StackPanel>

            <Border Classes="settingRowInner">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2">
                  <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_TelemetryToggle}" />
                  <TextBlock
                    MaxWidth="440"
                    Classes="caption"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{x:Static lang:Resources.Settings_TelemetryHint}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_TelemetryToggle}"
                  IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}" />
              </DockPanel>
            </Border>

            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_RestartGuide}" />
                <TextBlock
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Settings_RestartGuideHint}" />
              </StackPanel>
              <Button
                Padding="12,6"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_RestartGuide}"
                Command="{Binding RestartGuideCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Info}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_RestartGuide}" />
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Border>

        <!--  ═══ 更新卡片（浏览器无自动更新，隐藏） ═══  -->
        <Border Classes="settingsCard" IsVisible="{Binding !IsWebPlatform}">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.ArrowSync}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Update}" />
            </StackPanel>

            <!--  自动更新模式选择器  -->
            <Border Classes="settingRowInner">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2">
                  <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_AutoUpdate}" />
                  <TextBlock
                    MaxWidth="440"
                    Classes="caption"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{x:Static lang:Resources.Settings_AutoUpdateHint}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <ComboBox
                  MinWidth="160"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_AutoUpdate}"
                  FontSize="14"
                  ItemsSource="{Binding AutoUpdateOptions}"
                  SelectedIndex="{Binding AutoUpdateIndex, Mode=TwoWay}" />
              </DockPanel>
            </Border>

            <Border Classes="settingRowInner">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2">
                  <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_UpdateCheck}" />
                  <TextBlock
                    MaxWidth="440"
                    Classes="caption"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding UpdateStatusMessage}"
                    TextWrapping="Wrap" />
                </StackPanel>
                <Button
                  Padding="12,6"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateCheck}"
                  Command="{Binding CheckForUpdateCommand}"
                  IsEnabled="{Binding IsCheckingUpdate, Converter={x:Static conv:BoolConverters.Negate}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                    <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_UpdateCheck}" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </Border>

            <!--  已有待应用更新时显示重启按钮  -->
            <DockPanel IsVisible="{Binding HasPendingUpdate}">
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.Settings_UpdatePendingRestart}" />
              </StackPanel>
              <Button
                Padding="12,6"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateApply}"
                Classes="accent"
                Command="{Binding ApplyPendingUpdateAndRestartCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_UpdateApply}" />
                </StackPanel>
              </Button>
            </DockPanel>

            <!--  更新可用时显示下载按钮  -->
            <Border Classes="settingRowInner" IsVisible="{Binding IsUpdateAvailable}">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="body"
                  Text="{Binding UpdateVersionText, StringFormat='v{0}'}" />
                <Button
                  Padding="12,6"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateApply}"
                  Command="{Binding DownloadAndApplyUpdateCommand}"
                  IsEnabled="{Binding IsDownloading, Converter={x:Static conv:BoolConverters.Negate}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowDownload}" />
                    <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Settings_UpdateApply}" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </Border>

            <!--  下载进度条  -->
            <ProgressBar
              Height="6"
              IsVisible="{Binding IsDownloading}"
              Maximum="100"
              Minimum="0"
              Value="{Binding UpdateDownloadProgress}" />
          </StackPanel>
        </Border>

        <!--  ═══ 工具卡片 ═══  -->
        <Border Classes="settingsCard">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                FontSize="18"
                Foreground="{DynamicResource SystemAccentColor}"
                Icon="{x:Static ficEnum:Icon.Toolbox}" />
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Settings_Tools}" />
            </StackPanel>

            <!--  数据管理  -->
            <TextBlock Classes="bodyStrong" Text="{x:Static lang:Resources.SeatSets_DataManagement}" />

            <Border Classes="settingRowInner">
              <DockPanel>
                <StackPanel DockPanel.Dock="Left" Spacing="2">
                  <TextBlock Classes="body" Text="{x:Static lang:Resources.SeatSets_Export}" />
                  <TextBlock
                    Classes="caption"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{x:Static lang:Resources.SeatSets_ExportHint}" />
                </StackPanel>
                <Button
                  Padding="12,6"
                  HorizontalAlignment="Right"
                  AutomationProperties.Name="{x:Static lang:Resources.SeatSets_Export}"
                  Command="{Binding ExportSeatSetsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowExport}" />
                    <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.SeatSets_Export}" />
                  </StackPanel>
                </Button>
              </DockPanel>
            </Border>

            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Spacing="2">
                <TextBlock Classes="body" Text="{x:Static lang:Resources.SeatSets_Import}" />
                <TextBlock
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.SeatSets_ImportHint}" />
              </StackPanel>
              <Button
                Padding="12,6"
                HorizontalAlignment="Right"
                AutomationProperties.Name="{x:Static lang:Resources.SeatSets_Import}"
                Command="{Binding ImportSeatSetsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowImport}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.SeatSets_Import}" />
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
