<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SettingsView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SettingsViewModel">

  <Design.DataContext>
    <vm:SettingsViewModel />
  </Design.DataContext>

  <DockPanel>
    <!--  ═══ 命令栏 ═══  -->
    <Border DockPanel.Dock="Top" Classes="sf-toolbar">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Classes="sf-h1"
          DockPanel.Dock="Left"
          Text="{x:Static lang:Resources.Settings_Title}" />
        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="6">
          <Button
            x:Name="SaveSettingsButton"
            AutomationProperties.Name="{x:Static lang:Resources.Settings_Save}"
            Classes="sf-btn sf-primary"
            Command="{Binding SaveSettingsCommand}"
            IsDefault="True">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_Save}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Settings_ResetDefaults}"
            Classes="sf-btn"
            Command="{Binding ResetDefaultsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_ResetDefaults}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══ 状态栏 ═══  -->
    <Border DockPanel.Dock="Bottom" Classes="sf-statusbar">
      <Grid Margin="16,0">
        <TextBlock
          VerticalAlignment="Center"
          Classes="sf-xs sf-dim"
          Text="{Binding StatusMessage}" />
      </Grid>
    </Border>

    <!--  ═══ 内容区：分组卡片网格（桌面两列 / 紧凑单列） ═══  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel
        MaxWidth="1100"
        Margin="{StaticResource SfPagePadding}"
        HorizontalAlignment="Stretch">
        <!--  M6 后修复：WrapPanel 行高独立（原 UniformGrid 全网格等高导致短卡片出现大片空白）；
              卡片宽度由 code-behind 按可用宽度/列数动态计算（桌面两列 / ≤900px 单列）。  -->
        <WrapPanel
          x:Name="SettingsCards"
          ItemSpacing="{StaticResource SfSpace4}"
          LineSpacing="{StaticResource SfSpace4}"
          Orientation="Horizontal">

          <!--  ─── 外观 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.PaintBrush}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Appearance}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_ThemeMode}" />
                  <ComboBox
                    MinWidth="150"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_ThemeMode}"
                    Classes="sf-input"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_AccentColor}" />
                  <ComboBox
                    MinWidth="150"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_AccentColor}"
                    Classes="sf-input"
                    ItemsSource="{Binding AccentColorOptions}"
                    SelectedIndex="{Binding AccentColorIndex, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_DefaultZoom}" />
                  <ComboBox
                    MinWidth="150"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_DefaultZoom}"
                    Classes="sf-input"
                    ItemsSource="{Binding ZoomOptions}"
                    SelectedIndex="{Binding ZoomIndex, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_LanguageLabel}" />
                  <ComboBox
                    MinWidth="170"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_LanguageLabel}"
                    Classes="sf-input"
                    ItemsSource="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LanguageOption">
                        <TextBlock Classes="sf-sm" Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 行为 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Options}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Behavior}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_ConfirmClear}" />
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_ConfirmClear}"
                    IsChecked="{Binding ConfirmBeforeClear, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_SuppressEnvWarning}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_SuppressEnvWarningHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_SuppressEnvWarning}"
                    IsChecked="{Binding SuppressEnvironmentWarning, Mode=TwoWay}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 键盘快捷键 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel
                x:Name="KeyboardShortcutsSection"
                Orientation="Horizontal"
                Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Keyboard}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_KeyboardShortcuts}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Undo}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_UndoHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    x:Name="UndoShortcutSwitch"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Undo}"
                    IsChecked="{Binding UndoShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Redo}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_RedoHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Redo}"
                    IsChecked="{Binding RedoShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Save}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_SaveHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Save}"
                    IsChecked="{Binding SaveShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Zoom}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_ZoomHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Zoom}"
                    IsChecked="{Binding ZoomShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Delete}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_DeleteHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Delete}"
                    IsChecked="{Binding DeleteShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_KbShortcut_Escape}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_KbShortcut_EscapeHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_KbShortcut_Escape}"
                    IsChecked="{Binding EscapeShortcutEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 存储（浏览器无文件系统路径，隐藏） ───  -->
          <Border Classes="sf-card" IsVisible="{Binding !IsWebPlatform}">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Folder}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Storage}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <StackPanel Spacing="6">
                  <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_DataDir}" />
                  <DockPanel>
                    <Button
                      Padding="8,8"
                      AutomationProperties.Name="{x:Static lang:Resources.Settings_BrowseDataDir}"
                      Classes="sf-btn sf-icon"
                      Command="{Binding BrowseDataDirectoryCommand}"
                      DockPanel.Dock="Right"
                      Margin="6,0,0,0">
                      <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Folder}" />
                    </Button>
                    <TextBox
                      Classes="sf-input"
                      PlaceholderText="{x:Static lang:Resources.Settings_DataDirPlaceholder}"
                      Text="{Binding DataDirectory, Mode=TwoWay}" />
                  </DockPanel>
                  <Button
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_OpenDataDir}"
                    Classes="sf-btn sf-ghost sf-sm"
                    Command="{Binding OpenDataDirectoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="12" Icon="{x:Static ficEnum:Icon.ArrowUpload}" />
                      <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Settings_OpenDataDir}" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_MaxSnapshots}" />
                  <NumericUpDown
                    Width="140"
                    HorizontalAlignment="Right"
                    Increment="1"
                    Maximum="300"
                    Minimum="0"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_MaxSnapshots}"
                    Classes="sf-input"
                    Value="{Binding MaxSnapshotsPerVenue, Mode=TwoWay}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 日志 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Document}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Logging}" />
              </StackPanel>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_LogLevel}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_LogLevelHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_LogLevel}"
                    Classes="sf-input"
                    ItemsSource="{Binding LogLevelOptions}"
                    SelectedIndex="{Binding LogLevelIndex, Mode=TwoWay}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 隐私 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Shield}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Privacy}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_TelemetryToggle}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_TelemetryHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_TelemetryToggle}"
                    IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_RestartGuide}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_RestartGuideHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                    HorizontalAlignment="Right"
                    Classes="sf-btn sf-sm"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_RestartGuide}"
                    Command="{Binding RestartGuideCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Info}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_RestartGuide}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  ─── 更新（浏览器无自动更新，隐藏） ───  -->
          <Border Classes="sf-card" IsVisible="{Binding !IsWebPlatform}">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Update}" />
              </StackPanel>

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_AutoUpdate}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.Settings_AutoUpdateHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <ComboBox
                    MinWidth="150"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_AutoUpdate}"
                    Classes="sf-input"
                    ItemsSource="{Binding AutoUpdateOptions}"
                    SelectedIndex="{Binding AutoUpdateIndex, Mode=TwoWay}" />
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row" IsVisible="{Binding !HasPendingUpdate}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.Settings_UpdateCheck}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{Binding UpdateStatusMessage}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                    HorizontalAlignment="Right"
                    Classes="sf-btn sf-sm"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateCheck}"
                    Command="{Binding CheckForUpdateCommand}"
                    IsEnabled="{Binding IsCheckingUpdate, Converter={x:Static conv:BoolConverters.Negate}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_UpdateCheck}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>

              <!--  已有待应用更新时显示重启按钮  -->
              <Border Classes="sf-setting-row" IsVisible="{Binding HasPendingUpdate}">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Settings_UpdatePendingRestart}" />
                  <Button
                    HorizontalAlignment="Right"
                    Classes="sf-btn sf-primary sf-sm"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateApply}"
                    Command="{Binding ApplyPendingUpdateAndRestartCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_UpdateApply}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>

              <!--  更新可用时显示下载按钮  -->
              <Border Classes="sf-setting-row" IsVisible="{Binding IsUpdateAvailable}">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-text"
                    DockPanel.Dock="Left"
                    Text="{Binding UpdateVersionText, StringFormat='v{0}'}" />
                  <Button
                    HorizontalAlignment="Right"
                    Classes="sf-btn sf-sm"
                    AutomationProperties.Name="{x:Static lang:Resources.Settings_UpdateApply}"
                    Command="{Binding DownloadAndApplyUpdateCommand}"
                    IsEnabled="{Binding IsDownloading, Converter={x:Static conv:BoolConverters.Negate}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowDownload}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Settings_UpdateApply}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>

              <!--  下载进度条  -->
              <ProgressBar
                Height="6"
                IsVisible="{Binding IsDownloading}"
                Maximum="100"
                Minimum="0"
                Value="{Binding UpdateDownloadProgress}" />
            </StackPanel>
          </Border>

          <!--  ─── 工具 ───  -->
          <Border Classes="sf-card">
            <StackPanel Spacing="{StaticResource SfSpace3}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <fic:FluentIcon
                  FontSize="16"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Toolbox}" />
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Settings_Tools}" />
              </StackPanel>

              <TextBlock Classes="sf-sm sf-dim" Text="{x:Static lang:Resources.SeatSets_DataManagement}" />

              <Border Classes="sf-setting-row">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.SeatSets_Export}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.SeatSets_ExportHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                    HorizontalAlignment="Right"
                    Padding="12,6"
                    AutomationProperties.Name="{x:Static lang:Resources.SeatSets_Export}"
                    Classes="sf-btn sf-sm"
                    Command="{Binding ExportSeatSetsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowExport}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.SeatSets_Export}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>

              <Border Classes="sf-setting-row sf-last">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Left" Spacing="2">
                    <TextBlock Classes="sf-text" Text="{x:Static lang:Resources.SeatSets_Import}" />
                    <TextBlock
                      MaxWidth="300"
                      Classes="sf-hint"
                      Text="{x:Static lang:Resources.SeatSets_ImportHint}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                  <Button
                    HorizontalAlignment="Right"
                    Padding="12,6"
                    AutomationProperties.Name="{x:Static lang:Resources.SeatSets_Import}"
                    Classes="sf-btn sf-sm"
                    Command="{Binding ImportSeatSetsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowImport}" />
                      <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.SeatSets_Import}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
