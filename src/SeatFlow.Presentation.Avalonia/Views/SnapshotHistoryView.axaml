<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SnapshotHistoryView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:core="using:SeatFlow.Core.Models"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SnapshotHistoryViewModel">

  <DockPanel Classes="pageMargin">
    <!--  顶部标题栏  -->
    <Border Classes="toolbarTop" DockPanel.Dock="Top">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Classes="pageTitle"
          DockPanel.Dock="Left"
          Text="{x:Static lang:Resources.Snapshot_Title}" />
        <StackPanel
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="8">
          <!--  会场下拉  -->
          <ComboBox
            x:Name="VenueComboBox"
            Width="200"
            FontSize="13"
            ItemsSource="{Binding Venues}"
            PlaceholderText="{x:Static lang:Resources.Snapshot_SelectVenue}"
            SelectedItem="{Binding SelectedVenue, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VenueItem">
                <TextBlock Classes="bodySmall" Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button HorizontalContentAlignment="Center" Command="{Binding LoadVenuesCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Common_Refresh}" />
            </StackPanel>
          </Button>
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_Create}"
            Command="{Binding CreateSnapshotCommand}"
            IsEnabled="{Binding CanCreateSnapshot}"
            IsVisible="{Binding IsNotBatchMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Snapshot_Create}" />
            </StackPanel>
          </Button>
          <!--  批量删除按钮（非批量模式）  -->
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_BatchDelete}"
            Command="{Binding EnterBatchDeleteModeCommand}"
            IsEnabled="{Binding CanEnterBatchDelete}"
            IsVisible="{Binding IsNotBatchMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Snapshot_BatchDelete}" />
            </StackPanel>
          </Button>
          <!--  批量删除确认按钮（批量模式）  -->
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_ConfirmDelete}"
            Command="{Binding ConfirmBatchDeleteCommand}"
            IsVisible="{Binding IsBatchDeleteMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon
                FontSize="14"
                Foreground="{DynamicResource ErrorBrush}"
                Icon="{x:Static ficEnum:Icon.Delete}" />
              <TextBlock
                Classes="bodySmall"
                Foreground="{DynamicResource ErrorBrush}"
                Text="{x:Static lang:Resources.Snapshot_ConfirmDelete}" />
            </StackPanel>
          </Button>
          <Button
            HorizontalContentAlignment="Center"
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_BatchDelete}"
            Command="{Binding ExitBatchDeleteModeCommand}"
            IsVisible="{Binding IsBatchDeleteMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Common_Cancel}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  底部状态栏  -->
    <Border Classes="statusBarBottom" DockPanel.Dock="Bottom">
      <DockPanel>
        <TextBlock
          Classes="caption"
          DockPanel.Dock="Right"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          Text="{Binding SnapshotQuotaDisplay}" />
        <TextBlock
          Classes="caption"
          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
          Text="{Binding StatusMessage}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="280,4,*">
      <!--  左侧：快照列表  -->
      <Border
        Grid.Column="0"
        Margin="0,0,8,0"
        Background="{DynamicResource SidebarBackgroundBrush}"
        CornerRadius="6">
        <Grid Margin="8" RowDefinitions="Auto,*">
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Classes="bodyStrong"
            Text="{x:Static lang:Resources.Snapshot_List}" />

          <!--  加载遮罩  -->
          <Border
            Grid.Row="1"
            Classes="loadingOverlay"
            IsVisible="{Binding IsLoading}"
            ZIndex="10">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="12">
              <ProgressBar
                Width="160"
                Height="4"
                IsIndeterminate="True" />
              <TextBlock
                HorizontalAlignment="Center"
                Classes="caption"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{x:Static lang:Resources.Common_Loading}" />
            </StackPanel>
          </Border>

          <!--  正常模式  -->
          <Grid Grid.Row="1" IsVisible="{Binding IsNotBatchMode}">
            <!--  空列表  -->
            <Border IsVisible="{Binding !HasSnapshots}">
              <StackPanel
                Margin="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <fic:FluentIcon
                  HorizontalAlignment="Center"
                  FontSize="32"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Icon="{x:Static ficEnum:Icon.History}" />
                <TextBlock
                  HorizontalAlignment="Center"
                  Classes="caption"
                  Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Text="{x:Static lang:Resources.Snapshot_NoSelectedVenue}"
                  TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <!--  正常模式列表  -->
            <ListBox
              x:Name="SnapshotListBox"
              Background="{DynamicResource SidebarBackgroundBrush}"
              BorderThickness="0"
              IsVisible="{Binding HasSnapshots}"
              ItemsSource="{Binding Snapshots}"
              SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:SeatingSnapshot">
                  <StackPanel Margin="4,4">
                    <TextBlock
                      Classes="bodySmall"
                      FontWeight="SemiBold"
                      Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                    <TextBlock
                      MaxHeight="32"
                      Classes="small"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{Binding Description}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Classes="micro"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{Binding SeatAssignments.Count}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!--  批量模式  -->
          <StackPanel Grid.Row="1" IsVisible="{Binding IsBatchDeleteMode}">
            <CheckBox
              Margin="4,4,4,8"
              FontSize="13"
              IsChecked="{Binding IsAllSelected, Mode=TwoWay}">
              <TextBlock Classes="bodySmall" Text="{Binding SelectAllDisplay}" />
            </CheckBox>
            <ListBox
              Background="{DynamicResource SidebarBackgroundBrush}"
              BorderThickness="0"
              ItemsSource="{Binding CheckableItems}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableItem">
                  <CheckBox Margin="4,4" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <StackPanel>
                      <TextBlock Classes="bodySmallStrong" Text="{Binding Snapshot.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                      <TextBlock
                        MaxHeight="32"
                        Classes="small"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="{Binding Snapshot.Description}"
                        TextWrapping="Wrap" />
                      <TextBlock
                        Classes="micro"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Text="{Binding Snapshot.SeatAssignments.Count}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter
        Grid.Column="1"
        Width="4"
        Background="Transparent" />

      <!--  右侧：详情  -->
      <Grid Grid.Column="2">
        <!--  未选中  -->
        <Border
          Padding="40"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          CornerRadius="8"
          IsVisible="{Binding !HasSelectedSnapshot}">
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <fic:FluentIcon
              HorizontalAlignment="Center"
              FontSize="48"
              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              Icon="{x:Static ficEnum:Icon.History}" />
            <TextBlock
              HorizontalAlignment="Center"
              Classes="body"
              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              Text="{x:Static lang:Resources.Snapshot_SelectHint}" />
          </StackPanel>
        </Border>

        <!--  详情（仅 SelectedSnapshot 非 null 时显示）  -->
        <Border
          Padding="16"
          Background="{DynamicResource SidebarBackgroundBrush}"
          CornerRadius="6"
          IsVisible="{Binding HasSelectedSnapshot}">
          <DockPanel>
            <StackPanel
              Margin="0,12,0,0"
              HorizontalAlignment="Right"
              DockPanel.Dock="Bottom"
              Orientation="Horizontal"
              Spacing="8">
              <Button
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="{x:Static lang:Resources.Snapshot_DeleteHint}"
                Command="{Binding DeleteSnapshotCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Common_Delete}" />
                </StackPanel>
              </Button>
              <Button
                x:Name="RollbackButton"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="{x:Static lang:Resources.Snapshot_RollbackHint}"
                Classes="accent"
                Command="{Binding RollbackCommand}"
                IsEnabled="{Binding !HasRollbackDisabled}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Snapshot_Rollback}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <ScrollViewer>
              <StackPanel Spacing="14">
                <!--  用 ContentControl + DataTemplate 防止 SelectedSnapshot 为 null 时绑定报错  -->
                <ContentControl Content="{Binding SelectedSnapshot}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="core:SeatingSnapshot">
                      <StackPanel Spacing="10">
                        <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.Snapshot_Detail}" />
                        <StackPanel Spacing="4">
                          <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_Id}" />
                          <TextBlock
                            Classes="small"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Id}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_CreatedAt}" />
                          <TextBlock Classes="caption" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_Description}" />
                          <TextBlock
                            Classes="caption"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_SeatCount}" />
                          <TextBlock Classes="caption" Text="{Binding SeatAssignments.Count}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_LinkedVenue}" />
                          <TextBlock
                            Classes="small"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding LayoutId}"
                            TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!--  警告横幅  -->
                <Border
                  Padding="10"
                  Classes="bgError"
                  CornerRadius="4"
                  IsVisible="{Binding IsVenueDeleted}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="bodySmallStrong"
                      Foreground="{DynamicResource ErrorBrush}"
                      Text="{x:Static lang:Resources.Snapshot_VenueDeletedPreview}" />
                    <TextBlock
                      Classes="small"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{x:Static lang:Resources.Snapshot_VenueDeletedMsg}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border
                  Padding="10"
                  Classes="bgWarning"
                  CornerRadius="4"
                  IsVisible="{Binding IsVenueChanged}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="bodySmallStrong"
                      Foreground="{DynamicResource WarningBrush}"
                      Text="{Binding VenueWarningText}" />
                    <TextBlock
                      Classes="small"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{x:Static lang:Resources.Snapshot_VenueChanged}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border
                  Padding="10"
                  Classes="bgWarning"
                  CornerRadius="4"
                  IsVisible="{Binding IsDataChanged}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="bodySmallStrong"
                      Foreground="{DynamicResource WarningBrush}"
                      Text="{x:Static lang:Resources.Snapshot_DataChanged}" />
                    <TextBlock
                      Classes="small"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{x:Static lang:Resources.Snapshot_DataChangedMsg}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!--  会场预览（绑定 ViewModel 属性，置于 ContentControl 外部避免 DataContext 错误）  -->
                <Border
                  Padding="8"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                  CornerRadius="4"
                  IsVisible="{Binding HasPreview}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="bodySmallStrong" Text="{x:Static lang:Resources.Snapshot_Preview}" />
                    <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding PreviewSeats}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas Width="{Binding PreviewCanvasWidth}" Height="{Binding PreviewCanvasHeight}" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                          <Style Selector="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{ReflectionBinding X}" />
                            <Setter Property="Canvas.Top" Value="{ReflectionBinding Y}" />
                          </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SeatDisplayItem">
                            <Border
                              Width="{Binding Width}"
                              Height="{Binding Height}"
                              Background="{Binding BackgroundBrush}"
                              BorderBrush="{Binding BorderBrush}"
                              BorderThickness="1"
                              CornerRadius="{Binding CornerRadius}"
                              ToolTip.Tip="{Binding TooltipText}">
                              <TextBlock
                                Margin="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Text="{Binding DisplayText}"
                                TextTrimming="CharacterEllipsis" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
