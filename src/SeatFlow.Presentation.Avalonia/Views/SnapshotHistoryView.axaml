<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SnapshotHistoryView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:SeatFlow.Presentation.Avalonia.Controls"
  xmlns:core="using:SeatFlow.Core.Models"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SnapshotHistoryViewModel">

  <DockPanel>
    <!--  ═══ 命令栏 ═══  -->
    <Border DockPanel.Dock="Top" Classes="sf-toolbar">
      <DockPanel>
        <StackPanel
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          Orientation="Horizontal"
          Spacing="8">
          <TextBlock Classes="sf-h1" Text="{x:Static lang:Resources.Snapshot_Title}" />
          <ComboBox
            x:Name="VenueComboBox"
            Width="200"
            VerticalAlignment="Center"
            Classes="sf-input"
            ItemsSource="{Binding Venues}"
            PlaceholderText="{x:Static lang:Resources.Snapshot_SelectVenue}"
            SelectedItem="{Binding SelectedVenue, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:VenueItem">
                <TextBlock Classes="sf-sm" Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Common_Refresh}"
            Classes="sf-btn sf-icon"
            Command="{Binding LoadVenuesCommand}"
            ToolTip.Tip="{x:Static lang:Resources.Common_Refresh}">
            <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
          </Button>
        </StackPanel>

        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="6">
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_ListShort}"
            Classes="sf-btn sf-sm"
            Command="{Binding ListPanel.ToggleCommand}"
            IsVisible="{Binding Layout.IsCompact}">
            <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Snapshot_ListShort}" />
          </Button>
          <Border Classes="sf-sep-v" IsVisible="{Binding Layout.IsCompact}" />
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_Create}"
            Classes="sf-btn sf-primary"
            Command="{Binding CreateSnapshotCommand}"
            IsEnabled="{Binding CanCreateSnapshot}"
            IsVisible="{Binding IsNotBatchMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Snapshot_Create}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_BatchDelete}"
            Classes="sf-btn"
            Command="{Binding EnterBatchDeleteModeCommand}"
            IsEnabled="{Binding CanEnterBatchDelete}"
            IsVisible="{Binding IsNotBatchMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Snapshot_BatchDelete}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Snapshot_ConfirmDelete}"
            Classes="sf-btn sf-danger"
            Command="{Binding ConfirmBatchDeleteCommand}"
            IsVisible="{Binding IsBatchDeleteMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
              <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Snapshot_ConfirmDelete}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Common_Cancel}"
            Classes="sf-btn"
            Command="{Binding ExitBatchDeleteModeCommand}"
            IsVisible="{Binding IsBatchDeleteMode}">
            <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Cancel}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══ 状态栏 ═══  -->
    <Border DockPanel.Dock="Bottom" Classes="sf-statusbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Classes="sf-xs sf-dim"
          Text="{Binding StatusMessage}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Classes="sf-xs sf-faint sf-num"
          Text="{Binding SnapshotQuotaDisplay}" />
      </Grid>
    </Border>

    <!--  ═══ 内容区（快照列表 / 详情预览 / 紧凑遮罩） ═══  -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!--  ─── 左：快照列表（桌面内联 / 紧凑右抽屉） ───  -->
      <Border
        x:Name="SnapshotListPanel"
        Grid.Column="{Binding ListPanel.Column}"
        Width="{Binding ListPanel.Width}"
        HorizontalAlignment="{Binding ListPanel.Alignment}"
        ZIndex="{Binding ListPanel.ZIndex}"
        Background="{DynamicResource SfSurface2Brush}"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="{Binding ListPanel.BorderThickness}"
        IsVisible="{Binding ListPanel.Visible}">
        <Grid Margin="12" RowDefinitions="Auto,*">
          <TextBlock
            Grid.Row="0"
            Margin="0,0,0,8"
            Classes="sf-h3"
            Text="{x:Static lang:Resources.Snapshot_List}" />

          <!--  加载遮罩  -->
          <Border
            Grid.Row="1"
            Background="{DynamicResource SfSurface2Brush}"
            IsVisible="{Binding IsLoading}"
            Opacity="0.85"
            ZIndex="10">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="12">
              <ProgressBar
                Width="160"
                Height="4"
                IsIndeterminate="True" />
              <TextBlock
                HorizontalAlignment="Center"
                Classes="sf-xs sf-faint"
                Text="{x:Static lang:Resources.Common_Loading}" />
            </StackPanel>
          </Border>

          <!--  正常模式  -->
          <Grid Grid.Row="1" IsVisible="{Binding IsNotBatchMode}">
            <StackPanel
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Spacing="8"
              IsVisible="{Binding !HasSnapshots}">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="32"
                Foreground="{DynamicResource SfTextFaintBrush}"
                Icon="{x:Static ficEnum:Icon.History}" />
              <TextBlock
                HorizontalAlignment="Center"
                Classes="sf-xs sf-faint"
                Text="{x:Static lang:Resources.Snapshot_NoSelectedVenue}"
                TextWrapping="Wrap" />
            </StackPanel>
            <ListBox
              x:Name="SnapshotListBox"
              Classes="sf-select"
              IsVisible="{Binding HasSnapshots}"
              ItemsSource="{Binding Snapshots}"
              SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:SeatingSnapshot">
                  <StackPanel Spacing="2">
                    <TextBlock
                      Classes="sf-sm"
                      FontWeight="SemiBold"
                      Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                    <TextBlock
                      MaxHeight="32"
                      Classes="sf-xs sf-dim"
                      Text="{Binding Description}"
                      TextWrapping="Wrap" />
                    <TextBlock
                      Classes="sf-xs sf-faint sf-num"
                      Text="{Binding SeatAssignments.Count}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <!--  批量模式  -->
          <StackPanel Grid.Row="1" IsVisible="{Binding IsBatchDeleteMode}">
            <CheckBox
              Margin="4,4,4,8"
              Classes="sf-check"
              IsChecked="{Binding IsAllSelected, Mode=TwoWay}">
              <TextBlock Classes="sf-sm" Text="{Binding SelectAllDisplay}" />
            </CheckBox>
            <ListBox
              Classes="sf-select"
              ItemsSource="{Binding CheckableItems}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableItem">
                  <CheckBox Classes="sf-check" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="sf-sm" FontWeight="SemiBold" Text="{Binding Snapshot.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
                      <TextBlock
                        MaxHeight="32"
                        Classes="sf-xs sf-dim"
                        Text="{Binding Snapshot.Description}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>

      <!--  ─── 右：详情 + 预览 ───  -->
      <Grid Grid.Column="1" Margin="16,12,16,12">
        <!--  未选中  -->
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          IsVisible="{Binding !HasSelectedSnapshot}">
          <fic:FluentIcon
            HorizontalAlignment="Center"
            FontSize="48"
            Foreground="{DynamicResource SfTextFaintBrush}"
            Icon="{x:Static ficEnum:Icon.History}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-h3"
            Text="{x:Static lang:Resources.Snapshot_SelectHint}" />
        </StackPanel>

        <!--  详情  -->
        <Border Classes="sf-card" IsVisible="{Binding HasSelectedSnapshot}">
          <DockPanel>
            <StackPanel
              Margin="0,12,0,0"
              HorizontalAlignment="Right"
              DockPanel.Dock="Bottom"
              Orientation="Horizontal"
              Spacing="8">
              <Button
                AutomationProperties.Name="{x:Static lang:Resources.Snapshot_DeleteHint}"
                Classes="sf-btn sf-danger"
                Command="{Binding DeleteSnapshotCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
                  <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Delete}" />
                </StackPanel>
              </Button>
              <Button
                x:Name="RollbackButton"
                AutomationProperties.Name="{x:Static lang:Resources.Snapshot_RollbackHint}"
                Classes="sf-btn sf-primary"
                Command="{Binding RollbackCommand}"
                IsEnabled="{Binding !HasRollbackDisabled}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
                  <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Snapshot_Rollback}" />
                </StackPanel>
              </Button>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <!--  详情信息  -->
                <ContentControl Content="{Binding SelectedSnapshot}">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="core:SeatingSnapshot">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Snapshot_Detail}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Snapshot_Id}" />
                          <TextBlock Grid.Row="0" Grid.Column="1" Classes="sf-sm" Text="{Binding Id}" TextWrapping="Wrap" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Snapshot_CreatedAt}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="sf-sm sf-num" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Snapshot_Description}" />
                          <TextBlock Grid.Row="2" Grid.Column="1" Classes="sf-sm" Text="{Binding Description}" TextWrapping="Wrap" />
                          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,12,0" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Snapshot_LinkedVenue}" />
                          <TextBlock Grid.Row="3" Grid.Column="1" Classes="sf-sm" Text="{Binding $parent[UserControl].DataContext.SelectedSnapshotVenueDisplay}" TextWrapping="Wrap" />
                          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,12,0" Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Snapshot_LinkedDataset}" />
                          <TextBlock Grid.Row="4" Grid.Column="1" Classes="sf-sm" Text="{Binding $parent[UserControl].DataContext.SelectedSnapshotDatasetDisplay}" TextWrapping="Wrap" />
                        </Grid>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <!--  警告横幅  -->
                <Border Classes="sf-banner sf-danger" IsVisible="{Binding IsVenueDeleted}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="sf-sm"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource SfDangerBrush}"
                      Text="{x:Static lang:Resources.Snapshot_VenueDeletedPreview}" />
                    <TextBlock
                      Classes="sf-xs sf-dim"
                      Text="{x:Static lang:Resources.Snapshot_VenueDeletedMsg}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="sf-banner sf-warn" IsVisible="{Binding IsVenueChanged}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="sf-sm"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource SfWarnBrush}"
                      Text="{Binding VenueWarningText}" />
                    <TextBlock
                      Classes="sf-xs sf-dim"
                      Text="{x:Static lang:Resources.Snapshot_VenueChanged}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="sf-banner sf-warn" IsVisible="{Binding IsDataChanged}">
                  <StackPanel Spacing="4">
                    <TextBlock
                      Classes="sf-sm"
                      FontWeight="SemiBold"
                      Foreground="{DynamicResource SfWarnBrush}"
                      Text="{x:Static lang:Resources.Snapshot_DataChanged}" />
                    <TextBlock
                      Classes="sf-xs sf-dim"
                      Text="{x:Static lang:Resources.Snapshot_DataChangedMsg}"
                      TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <!--  预览（M4：自绘 SeatingCanvas，替代 ItemsControl + ReflectionBinding）  -->
                <StackPanel Spacing="8" IsVisible="{Binding HasPreview}">
                  <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Snapshot_Preview}" />
                  <Border
                    Height="300"
                    Padding="0"
                    Classes="sf-inset"
                    ClipToBounds="True">
                    <controls:SeatingCanvas Snapshot="{Binding PreviewSnapshot}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <!--  紧凑模式抽屉遮罩  -->
      <Border
        Grid.ColumnSpan="3"
        ZIndex="25"
        AutomationProperties.Name="{x:Static lang:Resources.Shell_CloseOverlay}"
        Background="{DynamicResource SfModalMaskBrush}"
        IsVisible="{Binding ListPanel.MaskVisible}"
        PointerPressed="OnDrawerMaskPressed" />
    </Grid>
  </DockPanel>
</UserControl>
