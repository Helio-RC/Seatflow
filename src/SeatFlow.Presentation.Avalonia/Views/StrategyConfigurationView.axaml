<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.StrategyConfigurationView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:StrategyConfigurationViewModel">

  <UserControl.Styles>
    <Style Selector="ListBox.sf-select">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem">
      <Setter Property="CornerRadius" Value="{StaticResource SfRadiusSm}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="{StaticResource SfFontSm}" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem:pointerover /template/ Border#PART_BackgroundBorder">
      <Setter Property="Background" Value="{DynamicResource SfHoverBrush}" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem:selected /template/ Border#PART_BackgroundBorder">
      <Setter Property="Background" Value="{DynamicResource SfSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SfAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!--  ═══ 命令栏 ═══  -->
    <Border DockPanel.Dock="Top" Classes="sf-toolbar">
      <DockPanel>
        <StackPanel
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          Orientation="Horizontal"
          Spacing="8">
          <TextBlock Classes="sf-h1" Text="{x:Static lang:Resources.Strategy_Title}" />
          <Border Classes="sf-chip sf-warn" IsVisible="{Binding HasChanges}">
            <TextBlock Classes="sf-xs" Foreground="{DynamicResource SfWarnBrush}" Text="{x:Static lang:Resources.Member_StatusDirty}" />
          </Border>
        </StackPanel>

        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="6">
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Strategy_ListShort}"
            Classes="sf-btn sf-sm"
            Command="{Binding ListPanel.ToggleCommand}"
            IsVisible="{Binding Layout.IsCompact}">
            <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Strategy_ListShort}" />
          </Button>
          <Border Classes="sf-sep-v" IsVisible="{Binding Layout.IsCompact}" />
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Strategy_RestoreDefaults}"
            Classes="sf-btn"
            Command="{Binding ResetConfigCommand}"
            IsEnabled="{Binding HasDetail}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUndo}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Strategy_RestoreDefaults}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="SaveAllButton"
            AutomationProperties.Name="{x:Static lang:Resources.Strategy_SaveChangesHint}"
            Classes="sf-btn sf-primary"
            Command="{Binding SaveAllCommand}"
            IsEnabled="{Binding HasChanges}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Strategy_SaveChanges}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══ 状态栏 ═══  -->
    <Border DockPanel.Dock="Bottom" Classes="sf-statusbar">
      <TextBlock
        VerticalAlignment="Center"
        Classes="sf-xs sf-dim"
        Text="{Binding StatusMessage}" />
    </Border>

    <!--  ═══ 内容区（策略列表 / 详情 / 紧凑遮罩） ═══  -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!--  ─── 左：策略列表（桌面内联 / 紧凑右抽屉） ───  -->
      <Border
        x:Name="StrategyListPanel"
        Grid.Column="{Binding ListPanel.Column}"
        Width="{Binding ListPanel.Width}"
        HorizontalAlignment="{Binding ListPanel.Alignment}"
        ZIndex="{Binding ListPanel.ZIndex}"
        Background="{DynamicResource SfSurface2Brush}"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="{Binding ListPanel.BorderThickness}"
        IsVisible="{Binding ListPanel.Visible}">
        <DockPanel>
          <TextBlock
            Margin="12,12,12,6"
            Classes="sf-h3"
            DockPanel.Dock="Top"
            Text="{x:Static lang:Resources.Strategy_List}" />

          <!--  配置失效提示  -->
          <Border
            Margin="12,0,12,6"
            Classes="sf-banner sf-warn"
            DockPanel.Dock="Top">
            <TextBlock
              Classes="sf-xs"
              Foreground="{DynamicResource SfWarnBrush}"
              Text="{x:Static lang:Resources.Strategy_ConfigInvalidHint}"
              TextWrapping="Wrap" />
          </Border>

          <!--  底部：移动 + 图例  -->
          <StackPanel Margin="12,6,12,12" DockPanel.Dock="Bottom" Spacing="6">
            <Border Classes="sf-divider" />
            <TextBlock Classes="sf-xs sf-faint" Text="{x:Static lang:Resources.Strategy_LegendPriority}" TextWrapping="Wrap" />
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Strategy_MoveUp}"
              Classes="sf-btn sf-block"
              Command="{Binding MoveUpCommand}"
              CommandParameter="{Binding SelectedStrategy}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUp}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Strategy_MoveUp}" />
              </StackPanel>
            </Button>
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Strategy_MoveDown}"
              Classes="sf-btn sf-block"
              Command="{Binding MoveDownCommand}"
              CommandParameter="{Binding SelectedStrategy}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowDown}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Strategy_MoveDown}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ListBox
            x:Name="StrategyListBox"
            AutomationProperties.Name="{x:Static lang:Resources.Strategy_List}"
            Classes="sf-select"
            ItemsSource="{Binding Strategies}"
            SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StrategyItemViewModel">
                <DockPanel>
                  <ToggleSwitch
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                  <Border
                    Width="4"
                    Margin="0,2,6,2"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource SfAccentBrush}"
                    CornerRadius="2"
                    DockPanel.Dock="Left"
                    IsVisible="{Binding ShowLeftBar}" />
                  <StackPanel Spacing="2">
                    <TextBlock
                      Classes="sf-sm"
                      FontWeight="SemiBold"
                      Text="{Binding DisplayName}"
                      TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="sf-xs sf-faint" Text="{Binding PriorityDisplay}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!--  ─── 右：详情 ───  -->
      <Grid Grid.Column="1" Margin="16,12,16,12">
        <!--  空状态：未选中策略  -->
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          IsVisible="{Binding !HasSelection}">
          <fic:FluentIcon
            HorizontalAlignment="Center"
            FontSize="48"
            Foreground="{DynamicResource SfTextFaintBrush}"
            Icon="{x:Static ficEnum:Icon.Options}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-h3"
            Text="{x:Static lang:Resources.Strategy_SelectHint2}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-sm sf-faint"
            Text="{x:Static lang:Resources.Strategy_SelectHint}" />
        </StackPanel>

        <!--  详情状态  -->
        <ScrollViewer IsVisible="{Binding HasDetail}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <!--  策略名称 + 来源  -->
            <Border Classes="sf-card">
              <StackPanel Spacing="8">
                <DockPanel>
                  <Border
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SfAccentSoftBrush}"
                    CornerRadius="{StaticResource SfRadiusPill}"
                    DockPanel.Dock="Right">
                    <TextBlock
                      Classes="sf-xs"
                      Foreground="{DynamicResource SfAccentStrongBrush}"
                      Text="{Binding DetailSourceDisplay}" />
                  </Border>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="sf-h2"
                    Text="{Binding SelectedDetail.DisplayName}" />
                </DockPanel>
                <TextBlock
                  Classes="sf-sm sf-dim"
                  Text="{Binding SelectedDetail.Description}"
                  TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <TextBlock Classes="sf-xs sf-faint" Text="{Binding DetailAuthorDisplay}" />
                  <TextBlock Classes="sf-xs sf-faint" Text="{Binding DetailCategoryDisplay}" />
                  <TextBlock Classes="sf-xs sf-faint" Text="{Binding DetailDefaultPriorityDisplay}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!--  基本配置  -->
            <Border Classes="sf-card">
              <StackPanel Spacing="12">
                <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.Strategy_BasicConfig}" />
                <Border Classes="sf-divider" />
                <DockPanel>
                  <TextBlock
                    Width="140"
                    VerticalAlignment="Center"
                    Classes="sf-sm"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Strategy_PriorityLabel}" />
                  <NumericUpDown
                    MinWidth="120"
                    HorizontalAlignment="Right"
                    Classes="sf-input"
                    Increment="1"
                    Maximum="999"
                    Minimum="0"
                    Value="{Binding EditPriority, Mode=TwoWay}" />
                </DockPanel>
                <Border Classes="sf-divider" />
                <DockPanel>
                  <TextBlock
                    Width="140"
                    VerticalAlignment="Center"
                    Classes="sf-sm"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.Strategy_EnableLabel}" />
                  <ToggleSwitch
                    x:Name="EditEnabledSwitch"
                    HorizontalAlignment="Right"
                    IsChecked="{Binding EditIsEnabled, Mode=TwoWay}" />
                </DockPanel>
              </StackPanel>
            </Border>

            <!--  策略参数（manifest parameters[] 驱动）  -->
            <Border Classes="sf-card" IsVisible="{Binding HasParameters}">
              <ContentControl Content="{Binding ParameterEditor}" />
            </Border>

            <!--  配置块（manifest codeBlocks[] 驱动）  -->
            <ItemsControl ItemsSource="{Binding ConfigBlockEditors}" />

            <!--  保存按钮  -->
            <StackPanel Margin="0,0,0,8" Orientation="Horizontal" Spacing="8">
              <Button
                AutomationProperties.Name="{x:Static lang:Resources.Strategy_SaveConfig}"
                Classes="sf-btn sf-primary"
                Command="{Binding SaveCurrentConfigCommand}"
                IsDefault="True">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
                  <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Strategy_SaveConfig}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!--  加载遮罩  -->
        <Border Background="{DynamicResource SfSurfaceBrush}" IsVisible="{Binding IsLoading}" Opacity="0.85">
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <ProgressBar Width="200" IsIndeterminate="True" />
            <TextBlock
              HorizontalAlignment="Center"
              Classes="sf-sm"
              Text="{x:Static lang:Resources.Common_Processing}" />
          </StackPanel>
        </Border>
      </Grid>

      <!--  紧凑模式抽屉遮罩  -->
      <Border
        Grid.ColumnSpan="3"
        ZIndex="25"
        AutomationProperties.Name="{x:Static lang:Resources.Shell_CloseOverlay}"
        Background="{DynamicResource SfModalMaskBrush}"
        IsVisible="{Binding ListPanel.MaskVisible}"
        PointerPressed="OnDrawerMaskPressed" />
    </Grid>
  </DockPanel>
</UserControl>
