<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.InputContent"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  Width="400"
  MinHeight="140"
  x:CompileBindings="False"
  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

  <DockPanel Margin="20,48,20,16">
    <StackPanel
      Margin="0,16,0,0"
      HorizontalAlignment="Right"
      DockPanel.Dock="Bottom"
      Orientation="Horizontal"
      Spacing="8">
      <Button
        x:Name="CancelButton"
        Classes="ActionCancel"
        Content="{x:Static lang:Resources.Common_Cancel}" />
      <Button
        x:Name="OkButton"
        Classes="ActionButton"
        Content="{x:Static lang:Resources.Common_OK}"
        IsDefault="True" />
    </StackPanel>

    <StackPanel Spacing="8">
      <TextBlock
        x:Name="PromptBlock"
        Classes="body"
        TextWrapping="Wrap" />
      <TextBox
        x:Name="InputBox"
        Padding="8,4"
        FontSize="14" />
    </StackPanel>
  </DockPanel>
</UserControl>
