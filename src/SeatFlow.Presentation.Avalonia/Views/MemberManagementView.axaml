<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.MemberManagementView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="using:SeatFlow.Presentation.Avalonia.Converters"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:models="using:SeatFlow.Core.Models"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:MemberManagementViewModel">

  <UserControl.Resources>
    <conv:GenderIndexConverter x:Key="GenderConverter" />
    <conv:HeightConverter x:Key="HeightConverter" />

    <!--  名单行模板（双列表共用；显示态仅 TextBlock，编辑态才渲染输入控件与操作按钮）  -->
    <DataTemplate x:Key="StudentRowTemplate" x:DataType="vm:StudentRowViewModel">
      <Border
        Height="36"
        Background="Transparent"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="0,0,0,1"
        KeyDown="OnRowEditKeyDown"
        PointerPressed="OnStudentRowPointerPressed">
        <Grid Margin="6,0" ColumnDefinitions="2*,*,*,Auto,Auto">
          <!--  姓名  -->
          <Panel Grid.Column="0">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding Name}"
              TextTrimming="CharacterEllipsis" />
            <TextBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              KeyDown="OnRowEditKeyDown"
              Text="{Binding NameText, Mode=TwoWay}" />
          </Panel>
          <!--  身高  -->
          <Panel Grid.Column="1">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm sf-num"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding HeightDisplay}" />
            <TextBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              KeyDown="OnRowEditKeyDown"
              Text="{Binding Height, Mode=TwoWay, Converter={StaticResource HeightConverter}}" />
          </Panel>
          <!--  性别  -->
          <Panel Grid.Column="2">
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-sm"
              IsVisible="{Binding !IsEditing}"
              Text="{Binding GenderDisplay}" />
            <ComboBox
              VerticalAlignment="Center"
              Classes="sf-input"
              Height="28"
              IsVisible="{Binding IsEditing}"
              SelectedIndex="{Binding GenderIndex, Mode=TwoWay}">
              <ComboBoxItem Content="" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Male}" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Female}" />
              <ComboBoxItem Content="{x:Static lang:Resources.Gender_Other}" />
            </ComboBox>
          </Panel>
          <!--  前排  -->
          <Panel Grid.Column="3" Width="64">
            <fic:FluentIcon
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource SfAccentBrush}"
              Icon="{x:Static ficEnum:Icon.CheckmarkCircle}"
              IsVisible="{Binding NeedsFrontRow}" />
            <CheckBox
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              IsChecked="{Binding IsFrontRow, Mode=TwoWay}"
              IsVisible="{Binding IsEditing}" />
          </Panel>
          <!--  操作（仅编辑态渲染，显示态该列为空）  -->
          <StackPanel
            Grid.Column="4"
            Width="60"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="2"
            IsVisible="{Binding IsEditing}">
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Save}"
              Classes="sf-btn sf-icon sf-ghost"
              Command="{Binding $parent[UserControl].DataContext.EndEditCommand}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{x:Static lang:Resources.Common_Save}">
              <fic:FluentIcon
                FontSize="14"
                Foreground="{DynamicResource SfAccentBrush}"
                Icon="{x:Static ficEnum:Icon.CheckmarkCircle}" />
            </Button>
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Delete}"
              Classes="sf-btn sf-icon sf-ghost"
              Command="{Binding $parent[UserControl].DataContext.DeleteStudentCommand}"
              CommandParameter="{Binding}"
              ToolTip.Tip="{x:Static lang:Resources.Common_Delete}">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox.sf-select">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem">
      <Setter Property="CornerRadius" Value="{StaticResource SfRadiusSm}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="{StaticResource SfFontSm}" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem:pointerover /template/ Border#PART_BackgroundBorder">
      <Setter Property="Background" Value="{DynamicResource SfHoverBrush}" />
    </Style>
    <Style Selector="ListBox.sf-select ListBoxItem:selected /template/ Border#PART_BackgroundBorder">
      <Setter Property="Background" Value="{DynamicResource SfSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SfAccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!--  名单行：固定行高，容器零内边距  -->
    <Style Selector="ListBox.sf-table ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!--  ═══ 命令栏 ═══  -->
    <Border DockPanel.Dock="Top" Classes="sf-toolbar">
      <DockPanel>
        <StackPanel
          VerticalAlignment="Center"
          DockPanel.Dock="Left"
          Orientation="Horizontal"
          Spacing="8">
          <TextBlock Classes="sf-h1" Text="{x:Static lang:Resources.Member_Title}" />
          <TextBlock
            VerticalAlignment="Bottom"
            Classes="sf-sm sf-faint"
            Text="{Binding HeaderSubtitle}" />
          <Border Classes="sf-chip" IsVisible="{Binding HasData}">
            <Panel>
              <TextBlock
                Classes="sf-xs"
                Foreground="{DynamicResource SfWarnBrush}"
                IsVisible="{Binding Dirty.IsDirty}"
                Text="{x:Static lang:Resources.Member_StatusDirty}" />
              <TextBlock
                Classes="sf-xs"
                Foreground="{DynamicResource SfOkBrush}"
                IsVisible="{Binding !Dirty.IsDirty}"
                Text="{x:Static lang:Resources.Member_StatusSaved}" />
            </Panel>
          </Border>
        </StackPanel>

        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          DockPanel.Dock="Right"
          Orientation="Horizontal"
          Spacing="6">
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Member_DatasetShort}"
            Classes="sf-btn sf-sm"
            Command="{Binding DatasetsPanel.ToggleCommand}"
            IsVisible="{Binding Layout.IsCompact}">
            <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Member_DatasetShort}" />
          </Button>
          <Border Classes="sf-sep-v" IsVisible="{Binding Layout.IsCompact}" />

          <Button AutomationProperties.Name="{x:Static lang:Resources.Data_Export}" Classes="sf-btn" IsEnabled="{Binding HasData}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Command="{Binding ExportCsvCommand}" Header="{x:Static lang:Resources.Member_ExportCSV}" />
                <MenuItem Command="{Binding ExportExcelCommand}" Header="{x:Static lang:Resources.Member_ExportExcel}" />
                <MenuItem Command="{Binding ExportJsonCommand}" Header="{x:Static lang:Resources.Member_ExportJSON}" />
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowUpload}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Data_Export}" />
              <fic:FluentIcon FontSize="10" Icon="{x:Static ficEnum:Icon.ChevronDown}" />
            </StackPanel>
          </Button>

          <Button
            x:Name="ExportTemplateButton"
            AutomationProperties.Name="{x:Static lang:Resources.Data_ExportTemplate}"
            Classes="sf-btn"
            Command="{Binding ExportTemplateCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Document}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Member_GetTemplate}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="ImportButton"
            AutomationProperties.Name="{x:Static lang:Resources.Member_ImportData}"
            Classes="sf-btn sf-primary"
            Command="{Binding ImportCommand}"
            IsEnabled="{Binding IsNotLoading}"
            IsVisible="{Binding IsImportMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.PeopleTeamAdd}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Member_ImportFromFile}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="UpdateFromFileButton"
            AutomationProperties.Name="{x:Static lang:Resources.Member_UpdateFromFile}"
            Classes="sf-btn sf-primary"
            Command="{Binding UpdateFromFileCommand}"
            IsEnabled="{Binding IsNotLoading}"
            IsVisible="{Binding IsUpdateMode}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Member_UpdateFromFile}" />
            </StackPanel>
          </Button>
          <Button
            x:Name="SaveButton"
            AutomationProperties.Name="{x:Static lang:Resources.Member_SaveDataset}"
            Classes="sf-btn"
            Command="{Binding SaveCommand}"
            IsEnabled="{Binding HasData}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Save}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                IsVisible="{Binding CompactCommandTextVisible}"
                Text="{x:Static lang:Resources.Common_Save}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Common_SaveAs}"
            Classes="sf-btn sf-icon"
            Command="{Binding RenameSaveCommand}"
            IsEnabled="{Binding HasData}"
            ToolTip.Tip="{x:Static lang:Resources.Common_SaveAs}">
            <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.SaveCopy}" />
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Data_UnloadData}"
            Classes="sf-btn sf-icon"
            Command="{Binding ClearDataCommand}"
            IsEnabled="{Binding HasData}"
            ToolTip.Tip="{x:Static lang:Resources.Data_UnloadData}">
            <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Dismiss}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!--  ═══ 状态栏 ═══  -->
    <Border DockPanel.Dock="Bottom" Classes="sf-statusbar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock
          Grid.Column="0"
          VerticalAlignment="Center"
          Classes="sf-xs sf-dim"
          Text="{Binding StatusMessage}" />
        <TextBlock
          Grid.Column="1"
          VerticalAlignment="Center"
          Classes="sf-xs sf-faint"
          IsVisible="{Binding HasData}"
          Text="{Binding FilePathDisplay}"
          TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <!--  ═══ 内容区（数据集面板 / 表格 / 紧凑遮罩） ═══  -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!--  数据集列表面板（桌面内联 / 紧凑右抽屉）  -->
      <Border
        x:Name="DatasetsPanelBorder"
        Grid.Column="{Binding DatasetsPanel.Column}"
        Width="{Binding DatasetsPanel.Width}"
        HorizontalAlignment="{Binding DatasetsPanel.Alignment}"
        ZIndex="{Binding DatasetsPanel.ZIndex}"
        Background="{DynamicResource SfSurface2Brush}"
        BorderBrush="{DynamicResource SfBorderBrush}"
        BorderThickness="{Binding DatasetsPanel.BorderThickness}"
        IsVisible="{Binding DatasetsPanel.Visible}">
        <DockPanel>
          <DockPanel Margin="12,12,12,4" DockPanel.Dock="Top">
            <Button
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              AutomationProperties.Name="{x:Static lang:Resources.Common_Refresh}"
              Classes="sf-btn sf-icon sf-ghost"
              Command="{Binding RefreshDatasetsCommand}"
              DockPanel.Dock="Right"
              ToolTip.Tip="{x:Static lang:Resources.Common_Refresh}">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ArrowSync}" />
            </Button>
            <TextBlock
              VerticalAlignment="Center"
              Classes="sf-h3"
              Text="{x:Static lang:Resources.Member_SavedDatasets}" />
          </DockPanel>

          <StackPanel Margin="12,0,12,12" DockPanel.Dock="Bottom" Spacing="6">
            <Border Classes="sf-divider" />
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Delete}"
              Classes="sf-btn sf-block"
              Command="{Binding DeleteSelectedDatasetCommand}"
              IsEnabled="{Binding HasSelectedDataset}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Delete}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Delete}" />
              </StackPanel>
            </Button>
            <Button
              AutomationProperties.Name="{x:Static lang:Resources.Common_Rename}"
              Classes="sf-btn sf-block"
              Command="{Binding RenameSelectedDatasetCommand}"
              IsEnabled="{Binding HasSelectedDataset}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Edit}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.Common_Rename}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <ListBox
            Classes="sf-select"
            ItemsSource="{Binding SavedDatasets}"
            SelectedItem="{Binding SelectedDataset, Mode=TwoWay}"
            SelectionMode="Toggle">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:StudentDatasetInfo">
                <StackPanel Spacing="2">
                  <TextBlock
                    Classes="sf-sm"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="sf-xs sf-faint" Text="{Binding StudentCount}" />
                    <TextBlock Classes="sf-xs sf-faint" Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!--  表格区  -->
      <Grid Grid.Column="1" Margin="16,12,16,12">
        <!--  空状态  -->
        <StackPanel
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8"
          IsVisible="{Binding IsEmpty}">
          <fic:FluentIcon
            HorizontalAlignment="Center"
            FontSize="48"
            Foreground="{DynamicResource SfTextFaintBrush}"
            Icon="{x:Static ficEnum:Icon.DataUsage}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-h3"
            Text="{x:Static lang:Resources.Common_NoData}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-sm sf-faint"
            Text="{x:Static lang:Resources.Member_EmptyHint}"
            TextWrapping="Wrap" />
        </StackPanel>

        <!--  表格  -->
        <Border Classes="sf-panel" IsVisible="{Binding HasData}">
          <Grid RowDefinitions="Auto,*,Auto">
            <!--  表头  -->
            <Border
              Grid.Row="0"
              Padding="12,8"
              Background="{DynamicResource SfSurface2Brush}"
              BorderBrush="{DynamicResource SfBorderBrush}"
              BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="2*,*,*,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Name}" />
                <TextBlock Grid.Column="1" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Height}" />
                <TextBlock Grid.Column="2" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_Gender}" />
                <TextBlock Grid.Column="3" Width="64" Classes="sf-xs" FontWeight="SemiBold" Text="{x:Static lang:Resources.Member_FrontRow}" />
                <TextBlock Grid.Column="4" Width="60" Classes="sf-xs" Text="" />
              </Grid>
            </Border>

            <!--  ≤300 行：非虚拟化（WASM 实测滚动零长任务；全部行一次性实例化）  -->
            <ListBox
              x:Name="StudentListBox"
              Grid.Row="1"
              AutomationProperties.Name="{x:Static lang:Resources.Member_Title}"
              Classes="sf-table"
              IsVisible="{Binding UseStaticRoster}"
              ItemTemplate="{StaticResource StudentRowTemplate}"
              ItemsSource="{Binding Students}"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <!--  >300 行：虚拟化（控制内存/首帧；滚动按需实例化）  -->
            <ListBox
              Grid.Row="1"
              AutomationProperties.Name="{x:Static lang:Resources.Member_Title}"
              Classes="sf-table"
              IsVisible="{Binding UseVirtualization}"
              ItemTemplate="{StaticResource StudentRowTemplate}"
              ItemsSource="{Binding Students}"
              ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <!--  底部新增行  -->
            <Border
              x:Name="NewStudentRow"
              Grid.Row="2"
              Padding="6,3"
              Background="{DynamicResource SfSurface2Brush}"
              BorderBrush="{DynamicResource SfBorderBrush}"
              BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="2*,*,*,Auto,Auto">
                <TextBox
                  Name="NewStudentNameBox"
                  Grid.Column="0"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Classes="sf-input"
                  Height="28"
                  KeyDown="OnNewStudentNameKeyDown"
                  PlaceholderText="{x:Static lang:Resources.Member_NewRowHint}"
                  Text="{Binding NewStudent.Name, Mode=TwoWay}" />
                <TextBox
                  Grid.Column="1"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Classes="sf-input"
                  Height="28"
                  PlaceholderText="{x:Static lang:Resources.Member_HeightPH}"
                  Text="{Binding NewStudent.Height, Mode=TwoWay, Converter={StaticResource HeightConverter}}" />
                <ComboBox
                  Grid.Column="2"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Classes="sf-input"
                  Height="28"
                  SelectedIndex="{Binding NewStudent.Gender, Mode=TwoWay, Converter={StaticResource GenderConverter}}">
                  <ComboBoxItem Content="" />
                  <ComboBoxItem Content="{x:Static lang:Resources.Gender_Male}" />
                  <ComboBoxItem Content="{x:Static lang:Resources.Gender_Female}" />
                  <ComboBoxItem Content="{x:Static lang:Resources.Gender_Other}" />
                </ComboBox>
                <CheckBox
                  Grid.Column="3"
                  Width="64"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsChecked="{Binding NewStudent.NeedsFrontRow, Mode=TwoWay}" />
                <Button
                  Grid.Column="4"
                  Width="60"
                  HorizontalContentAlignment="Center"
                  AutomationProperties.Name="{x:Static lang:Resources.Member_AddRow}"
                  Classes="sf-btn sf-sm"
                  Command="{Binding AddNewStudentCommand}"
                  ToolTip.Tip="{x:Static lang:Resources.Member_AddRow}">
                  <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Add}" />
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!--  加载遮罩  -->
        <Border
          Background="{DynamicResource SfSurfaceBrush}"
          IsVisible="{Binding IsLoading}"
          Opacity="0.85">
          <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <ProgressBar Width="200" IsIndeterminate="True" />
            <TextBlock
              HorizontalAlignment="Center"
              Classes="sf-sm"
              Text="{x:Static lang:Resources.Common_Processing}" />
          </StackPanel>
        </Border>
      </Grid>

      <!--  紧凑模式抽屉遮罩  -->
      <Border
        Grid.ColumnSpan="3"
        ZIndex="25"
        AutomationProperties.Name="{x:Static lang:Resources.Shell_CloseOverlay}"
        Background="{DynamicResource SfModalMaskBrush}"
        IsVisible="{Binding DatasetsPanel.MaskVisible}"
        PointerPressed="OnDrawerMaskPressed" />
    </Grid>
  </DockPanel>
</UserControl>
