<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.AboutView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:Name="AboutHost"
  x:DataType="vm:AboutViewModel">

  <Design.DataContext>
    <vm:AboutViewModel />
  </Design.DataContext>

  <DockPanel>
    <!--  ═══ 命令栏 ═══  -->
    <Border DockPanel.Dock="Top" Classes="sf-toolbar">
      <TextBlock
        VerticalAlignment="Center"
        Classes="sf-h1"
        Text="{x:Static lang:Resources.About_Title}" />
    </Border>

    <!--  ═══ 内容区 ═══  -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel
        MaxWidth="760"
        Margin="{StaticResource SfPagePadding}"
        HorizontalAlignment="Center"
        Spacing="{StaticResource SfSpace4}">

        <!--  Section 1: Hero  -->
        <Border Classes="sf-card">
          <Grid ColumnDefinitions="Auto,*">
            <!--
              跨平台图标：WASM 下 SVG-Skia 控件不可用（SkiaSharp 无 wasm native），
              统一使用 PNG 位图
            -->
            <Image
              Grid.Column="0"
              Width="72"
              Height="72"
              VerticalAlignment="Top"
              Source="/Assets/icon_with_background.png"
              Stretch="Uniform" />
            <StackPanel
              Grid.Column="1"
              Margin="20,0,0,0"
              Spacing="4">
              <TextBlock Classes="sf-h1" Text="{Binding AppName}" />
              <TextBlock
                Classes="sf-xs sf-dim sf-num"
                Text="{Binding VersionDisplay}" />
              <TextBlock
                Margin="0,8,0,0"
                Classes="sf-sm sf-dim"
                Text="{Binding Description}"
                TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>

        <!--  Section 2: Quick Link Cards  -->
        <Border Classes="sf-card">
          <WrapPanel HorizontalAlignment="Center">
            <Button
              Margin="4"
              AutomationProperties.Name="{x:Static lang:Resources.About_GitHub}"
              Classes="sf-btn"
              Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
              CommandParameter="{Binding GitHubUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon
                  FontSize="14"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Code}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.About_GitHub}" />
              </StackPanel>
            </Button>
            <Button
              Margin="4"
              AutomationProperties.Name="{x:Static lang:Resources.About_OfficialSite}"
              Classes="sf-btn"
              Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
              CommandParameter="{Binding OfficialSiteUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon
                  FontSize="14"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Globe}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.About_OfficialSite}" />
              </StackPanel>
            </Button>
            <Button
              Margin="4"
              AutomationProperties.Name="{x:Static lang:Resources.About_Documentation}"
              Classes="sf-btn"
              Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
              CommandParameter="{Binding DocsUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon
                  FontSize="14"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.BookOpen}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.About_Documentation}" />
              </StackPanel>
            </Button>
            <Button
              Margin="4"
              AutomationProperties.Name="{x:Static lang:Resources.About_Issues}"
              Classes="sf-btn"
              Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
              CommandParameter="{Binding IssuesUrl}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <fic:FluentIcon
                  FontSize="14"
                  Foreground="{DynamicResource SfAccentBrush}"
                  Icon="{x:Static ficEnum:Icon.Bug}" />
                <TextBlock Classes="sf-sm" Text="{x:Static lang:Resources.About_Issues}" />
              </StackPanel>
            </Button>
          </WrapPanel>
        </Border>

        <!--  Section 3: MIT License Banner（Grid 约束文本宽度以正确换行）  -->
        <Border Classes="sf-banner sf-warn">
          <Grid ColumnDefinitions="Auto,*">
            <fic:FluentIcon
              VerticalAlignment="Center"
              FontSize="14"
              Foreground="{DynamicResource SfWarnBrush}"
              Icon="{x:Static ficEnum:Icon.Info}" />
            <TextBlock
              Grid.Column="1"
              Margin="8,0,0,0"
              Classes="sf-sm"
              Text="{x:Static lang:Resources.About_MITLicenseWarning}"
              TextWrapping="Wrap" />
          </Grid>
        </Border>

        <!--  Section 4: System Info Card  -->
        <Border Classes="sf-card">
          <StackPanel Spacing="{StaticResource SfSpace3}">
            <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.About_Runtime}" />

            <Border Classes="sf-inset" Padding="12,8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-sm sf-dim sf-num"
                  Text="{Binding VersionDisplay}" />
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-xs sf-faint"
                  Text="·" />
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-sm sf-dim sf-num"
                  Text="{Binding BuildDate}" />
              </StackPanel>
            </Border>

            <Border Classes="sf-setting-row">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-sm"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.About_Framework}" />
                <TextBlock
                  HorizontalAlignment="Right"
                  Classes="sf-sm sf-dim sf-num"
                  Text="{Binding RuntimeVersion}" />
              </DockPanel>
            </Border>
            <Border Classes="sf-setting-row">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-sm"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.About_Avalonia}" />
                <TextBlock
                  HorizontalAlignment="Right"
                  Classes="sf-sm sf-dim sf-num"
                  Text="{Binding AvaloniaVersion}" />
              </DockPanel>
            </Border>
            <Border Classes="sf-setting-row sf-last">
              <DockPanel>
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-sm"
                  DockPanel.Dock="Left"
                  Text="{x:Static lang:Resources.About_License}" />
                <TextBlock
                  HorizontalAlignment="Right"
                  Classes="sf-sm sf-dim"
                  Text="{Binding License}" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>

        <!--  Section 5: Dependencies  -->
        <Border Classes="sf-card">
          <StackPanel Spacing="{StaticResource SfSpace3}">
            <TextBlock Classes="sf-h3" Text="{x:Static lang:Resources.About_Dependencies}" />

            <ItemsControl ItemsSource="{Binding Dependencies}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DependencyInfo">
                  <Border
                    MinWidth="220"
                    Margin="0,0,8,8"
                    Classes="sf-inset"
                    Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                      <Border
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Margin="0,5,10,0"
                        Classes="sf-dot sf-accent" />
                      <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Classes="sf-sm"
                        FontWeight="SemiBold"
                        Text="{Binding Name}" />
                      <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2,0,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                          Classes="sf-xs sf-dim sf-num"
                          Text="{Binding Version}" />
                        <TextBlock
                          Classes="sf-xs sf-faint"
                          Text="{Binding License}" />
                      </StackPanel>
                      <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,1,0,0"
                        Orientation="Horizontal"
                        Spacing="2">
                        <TextBlock
                          VerticalAlignment="Center"
                          Classes="sf-xs sf-faint"
                          Text="{Binding Purpose}"
                          TextWrapping="Wrap" />
                        <Button
                          Padding="2,0"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name}"
                          Classes="sf-btn sf-ghost sf-icon"
                          Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                          CommandParameter="{Binding Url}">
                          <fic:FluentIcon
                            FontSize="11"
                            Foreground="{DynamicResource SfTextFaintBrush}"
                            Icon="{x:Static ficEnum:Icon.Link}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!--  Section 6: Footer  -->
        <StackPanel
          Margin="0,8,0,8"
          HorizontalAlignment="Center"
          Spacing="4">
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-xs sf-dim"
            Text="{Binding Copyright}" />
          <TextBlock
            HorizontalAlignment="Center"
            Classes="sf-xs sf-faint"
            Text="{Binding License}" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
