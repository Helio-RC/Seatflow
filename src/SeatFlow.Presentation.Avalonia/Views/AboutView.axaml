<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.AboutView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:Name="AboutHost"
  x:DataType="vm:AboutViewModel">

  <Design.DataContext>
    <vm:AboutViewModel />
  </Design.DataContext>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  Page Title  -->
    <Border Grid.Row="0" Margin="0,0,0,24">
      <TextBlock
        VerticalAlignment="Center"
        Classes="pageTitle"
        Text="{x:Static lang:Resources.About_Title}" />
    </Border>

    <!--  Content Area  -->
    <Grid Grid.Row="1">
      <!--  Atmospheric accent glow (top-right, behind scroll content)  -->
      <Border
        Width="320"
        Height="320"
        Margin="0,0,24,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        CornerRadius="160"
        IsHitTestVisible="False"
        Opacity="0.03">
        <Border.Background>
          <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
        </Border.Background>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
          MaxWidth="680"
          Margin="0,0,0,32"
          HorizontalAlignment="Center"
          Spacing="0">

          <!--  Section 1: Hero  -->
          <Grid Margin="0,12,0,0" ColumnDefinitions="Auto,*">
            <!--
              跨平台图标：WASM 下 SVG-Skia 控件不可用（SkiaSharp 无 wasm native），
              统一使用 PNG 位图
            -->
            <Image
              Grid.Column="0"
              Width="100"
              Height="100"
              VerticalAlignment="Top"
              Source="/Assets/icon_with_background.png"
              Stretch="Uniform" />
            <StackPanel
              Grid.Column="1"
              Margin="24,0,0,0"
              Spacing="0">
              <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Text="{Binding AppName}" />
              <TextBlock
                Margin="0,2,0,0"
                Classes="bodySmall"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding VersionDisplay}" />
              <Separator Margin="0,12,0,12" />
              <TextBlock
                Classes="bodySmall"
                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                Text="{Binding Description}"
                TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

          <!--  Section 2: Quick Link Cards  -->
          <Border
            Margin="0,20,0,0"
            Padding="0"
            Classes="surfaceCard elevationSm radiusMd">
            <Grid ColumnDefinitions="*,*,*,*">
              <Button
                Grid.Column="0"
                AutomationProperties.Name="{x:Static lang:Resources.About_GitHub}"
                Classes="linkCard"
                Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                CommandParameter="{Binding GitHubUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemAccentColor}"
                    Icon="{x:Static ficEnum:Icon.Code}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.About_GitHub}" />
                </StackPanel>
              </Button>
              <Button
                Grid.Column="1"
                AutomationProperties.Name="{x:Static lang:Resources.About_OfficialSite}"
                Classes="linkCard"
                Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                CommandParameter="{Binding OfficialSiteUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemAccentColor}"
                    Icon="{x:Static ficEnum:Icon.Globe}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.About_OfficialSite}" />
                </StackPanel>
              </Button>
              <Button
                Grid.Column="2"
                AutomationProperties.Name="{x:Static lang:Resources.About_Documentation}"
                Classes="linkCard"
                Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                CommandParameter="{Binding DocsUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemAccentColor}"
                    Icon="{x:Static ficEnum:Icon.BookOpen}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.About_Documentation}" />
                </StackPanel>
              </Button>
              <Button
                Grid.Column="3"
                AutomationProperties.Name="{x:Static lang:Resources.About_Issues}"
                Classes="linkCard"
                Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                CommandParameter="{Binding IssuesUrl}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <fic:FluentIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemAccentColor}"
                    Icon="{x:Static ficEnum:Icon.Bug}" />
                  <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.About_Issues}" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>

          <!--  Section 3: MIT License Banner  -->
          <Border
            Margin="0,16,0,0"
            Padding="14"
            Classes="bgWarning radiusMd">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <fic:FluentIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource WarningBrush}"
                Icon="{x:Static ficEnum:Icon.Info}" />
              <TextBlock
                Classes="bodySmall"
                Text="{x:Static lang:Resources.About_MITLicenseWarning}"
                TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!--  Section 4: System Info Card  -->
          <Border
            Margin="0,16,0,0"
            Padding="20"
            Classes="surfaceCard elevationSm radiusMd">
            <StackPanel Spacing="0">
              <TextBlock
                Margin="0,0,0,12"
                Classes="sectionTitle"
                Text="{x:Static lang:Resources.About_Runtime}" />

              <Border Margin="0,0,0,16" Classes="versionBadge">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="textMono"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding VersionDisplay}" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="small"
                    Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Text="·" />
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="textMono"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding BuildDate}" />
                </StackPanel>
              </Border>

              <Separator Margin="0,0,0,4" />

              <Border Classes="settingRow">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="bodySmall"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.About_Framework}" />
                  <TextBlock
                    HorizontalAlignment="Right"
                    Classes="bodySmall"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding RuntimeVersion}" />
                </DockPanel>
              </Border>
              <Border Classes="settingRow">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="bodySmall"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.About_Avalonia}" />
                  <TextBlock
                    HorizontalAlignment="Right"
                    Classes="bodySmall"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding AvaloniaVersion}" />
                </DockPanel>
              </Border>
              <Border BorderThickness="0" Classes="settingRow">
                <DockPanel>
                  <TextBlock
                    VerticalAlignment="Center"
                    Classes="bodySmall"
                    DockPanel.Dock="Left"
                    Text="{x:Static lang:Resources.About_License}" />
                  <TextBlock
                    HorizontalAlignment="Right"
                    Classes="bodySmall"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    Text="{Binding License}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!--  Section 5: Dependencies Grid  -->
          <Border
            Margin="0,16,0,0"
            Padding="20"
            Classes="surfaceCard elevationSm radiusMd">
            <StackPanel Spacing="12">
              <TextBlock Classes="sectionTitle" Text="{x:Static lang:Resources.About_Dependencies}" />

              <ItemsControl ItemsSource="{Binding Dependencies}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DependencyInfo">
                    <Border Width="310" Classes="depCardItem">
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <Border
                          Grid.Row="0"
                          Grid.RowSpan="3"
                          Grid.Column="0"
                          Margin="0,3,10,0"
                          Background="{DynamicResource SystemAccentColor}"
                          Classes="badgeDot" />
                        <TextBlock
                          Grid.Row="0"
                          Grid.Column="1"
                          Classes="bodySmallStrong"
                          Text="{Binding Name}" />
                        <StackPanel
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,2,0,0"
                          Orientation="Horizontal"
                          Spacing="8">
                          <TextBlock
                            Classes="small"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Version}" />
                          <TextBlock
                            Classes="small"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding License}" />
                        </StackPanel>
                        <StackPanel
                          Grid.Row="2"
                          Grid.Column="1"
                          Margin="0,1,0,0"
                          Orientation="Horizontal"
                          Spacing="2">
                          <TextBlock
                            VerticalAlignment="Center"
                            Classes="caption"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Purpose}" />
                          <Button
                            Padding="2,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Name}"
                            Classes="depLink"
                            Command="{Binding #AboutHost.DataContext.OpenUrlCommand}"
                            CommandParameter="{Binding Url}">
                            <fic:FluentIcon
                              FontSize="11"
                              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Icon="{x:Static ficEnum:Icon.Link}" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!--  Section 6: Footer  -->
          <StackPanel
            Margin="0,24,0,0"
            HorizontalAlignment="Center"
            Spacing="4">
            <TextBlock
              HorizontalAlignment="Center"
              Classes="small"
              Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              Text="{Binding Copyright}" />
            <TextBlock
              HorizontalAlignment="Center"
              Classes="micro"
              Foreground="{DynamicResource SystemControlForegroundBaseLowBrush}"
              Text="{Binding License}" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>