<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.HomeView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:services="using:SeatFlow.Presentation.Avalonia.Services"
  xmlns:views="using:SeatFlow.Presentation.Avalonia.Views"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:HomeViewModel">

  <Design.DataContext>
    <vm:HomeViewModel />
  </Design.DataContext>

  <Grid Margin="48,40">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="720" Spacing="0">

        <!--  ═══ Row 1: Avatar + Greeting ═══  -->
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Border
            Width="48"
            Height="48"
            ClipToBounds="True"
            CornerRadius="24"
            IsVisible="{Binding HasUserAvatar}">
            <Image
              Width="48"
              Height="48"
              Source="{Binding UserAvatar}"
              Stretch="UniformToFill" />
          </Border>
          <Border
            x:Name="AvatarFallback"
            Width="48"
            Height="48"
            Background="{DynamicResource SystemAccentColor}"
            CornerRadius="24"
            IsVisible="{Binding !HasUserAvatar}">
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontSize="22"
              FontWeight="Bold"
              Foreground="{Binding Background, ElementName=AvatarFallback, Converter={x:Static views:HomeView.ContrastForeground}}"
              Text="{Binding UserInitialChar}" />
          </Border>
          <TextBlock
            VerticalAlignment="Center"
            FontSize="24"
            FontWeight="SemiBold"
            Text="{Binding GreetingLine}" />
        </StackPanel>

        <!--  ═══ Row 2: Doc Link Buttons ═══  -->
        <StackPanel
          Margin="0,24,0,0"
          Orientation="Horizontal"
          Spacing="8">
          <Button
            Padding="14,8"
            AutomationProperties.Name="{x:Static lang:Resources.Home_QuickStart}"
            Classes="accent"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="{Binding QuickStartUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.Rocket}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Home_QuickStart}" />
            </StackPanel>
          </Button>
          <Button
            Padding="14,8"
            AutomationProperties.Name="{x:Static lang:Resources.Home_Docs}"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="{Binding DocsUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.BookOpen}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Home_Docs}" />
            </StackPanel>
          </Button>
          <Button
            Padding="14,8"
            AutomationProperties.Name="{x:Static lang:Resources.Home_FAQ}"
            Command="{Binding OpenUrlCommand}"
            CommandParameter="{Binding FaqUrl}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="14" Icon="{x:Static ficEnum:Icon.ChatHelp}" />
              <TextBlock Classes="bodySmall" Text="{x:Static lang:Resources.Home_FAQ}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!--  ═══ Row 3: RELEASE.md Card ═══  -->
        <Border
          Margin="0,24,0,0"
          Padding="20"
          BorderBrush="{DynamicResource SystemControlForegroundChromeHighBrush}"
          BorderThickness="1"
          Classes="surfaceCard elevationMd radiusMd">
          <ItemsControl ItemsSource="{Binding ReleaseBlocks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:MdBlock">
                <Panel>
                  <!--  Title  -->
                  <TextBlock
                    Margin="0,12,0,2"
                    FontSize="20"
                    FontWeight="Bold"
                    IsVisible="{Binding IsTitle}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                  <!--  Heading  -->
                  <TextBlock
                    Margin="0,10,0,2"
                    FontSize="16"
                    FontWeight="SemiBold"
                    IsVisible="{Binding IsHeading}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                  <!--  SubHeading  -->
                  <TextBlock
                    Margin="0,6,0,2"
                    FontSize="14"
                    FontWeight="SemiBold"
                    IsVisible="{Binding IsSubHeading}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                  <!--  ListItem  -->
                  <Grid
                    Margin="12,1,0,1"
                    ColumnDefinitions="Auto,*"
                    IsVisible="{Binding IsListItem}">
                    <TextBlock
                      FontSize="13"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="·" />
                    <TextBlock
                      Grid.Column="1"
                      Margin="4,0,0,0"
                      FontSize="13"
                      Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                      Text="{Binding Text}"
                      TextWrapping="Wrap" />
                  </Grid>
                  <!--  Paragraph  -->
                  <TextBlock
                    Margin="0,3,0,3"
                    FontSize="13"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    IsVisible="{Binding IsParagraph}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
                  <!--  Code  -->
                  <Border
                    Margin="0,4"
                    Padding="12,8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="4"
                    IsVisible="{Binding IsCode}">
                    <TextBlock
                      FontFamily="Cascadia Code, JetBrains Mono, Consolas, monospace"
                      FontSize="12"
                      Text="{Binding Text}"
                      TextWrapping="Wrap" />
                  </Border>
                  <!--  Empty spacer  -->
                  <Border Height="8" IsVisible="{Binding IsEmpty}" />
                </Panel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
