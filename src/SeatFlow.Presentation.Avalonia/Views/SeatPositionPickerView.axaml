<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.SeatPositionPickerView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:SeatPositionPickerViewModel">
  <StackPanel Orientation="Horizontal" Spacing="4">
    <!--  Grid：范围由会场 GridLayoutMetadata 决定  -->
    <StackPanel
      IsVisible="{Binding IsGrid}"
      Orientation="Horizontal"
      Spacing="4">
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="{x:Static lang:Resources.SeatPosition_Row}" />
      <NumericUpDown
        Classes="sf-input"
        Maximum="{Binding GridMaxRow}"
        Minimum="1"
        Value="{Binding Row}" />
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="{x:Static lang:Resources.SeatPosition_Column}" />
      <NumericUpDown
        Classes="sf-input"
        Maximum="{Binding GridMaxColumn}"
        Minimum="1"
        Value="{Binding Column}" />
    </StackPanel>
    <!--  Polar：范围由会场 PolarLayoutMetadata 决定  -->
    <StackPanel
      IsVisible="{Binding IsPolar}"
      Orientation="Horizontal"
      Spacing="4">
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="{x:Static lang:Resources.SeatPosition_Ring}" />
      <NumericUpDown
        Classes="sf-input"
        Maximum="{Binding PolarMaxRing}"
        Minimum="1"
        Value="{Binding Ring}" />
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="{x:Static lang:Resources.SeatPosition_Angle}" />
      <NumericUpDown
        Classes="sf-input"
        Increment="15"
        Maximum="360"
        Minimum="0"
        Value="{Binding Angle}" />
    </StackPanel>
    <!--  Freeform：范围由会场实际坐标决定  -->
    <StackPanel
      IsVisible="{Binding IsFreeform}"
      Orientation="Horizontal"
      Spacing="4">
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="X" />
      <NumericUpDown
        Classes="sf-input"
        Increment="0.5"
        Maximum="{Binding FreeformMaxX}"
        Minimum="0"
        Value="{Binding X}" />
      <TextBlock VerticalAlignment="Center" Classes="sf-sm" Text="Y" />
      <NumericUpDown
        Classes="sf-input"
        Increment="0.5"
        Maximum="{Binding FreeformMaxY}"
        Minimum="0"
        Value="{Binding Y}" />
    </StackPanel>
  </StackPanel>
</UserControl>
