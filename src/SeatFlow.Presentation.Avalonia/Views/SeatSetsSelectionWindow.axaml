<Window
  x:Class="SeatFlow.Presentation.Avalonia.Views.SeatSetsSelectionWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:SeatFlow.Presentation.Avalonia.Views"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  Width="440"
  MinHeight="320"
  x:DataType="vm:SeatSetsSelectionViewModel"
  Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
  CanResize="False"
  ExtendClientAreaTitleBarHeightHint="32"
  ExtendClientAreaToDecorationsHint="True"
  ShowInTaskbar="False"
  SizeToContent="Height"
  WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:SeatSetsSelectionViewModel />
  </Design.DataContext>

  <local:SeatSetsSelectionContent
    x:Name="SelectionContent"
    Margin="24,52,24,20" />
</Window>
