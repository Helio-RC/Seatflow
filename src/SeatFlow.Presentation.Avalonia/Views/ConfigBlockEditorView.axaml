<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.ConfigBlockEditorView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:views="using:SeatFlow.Presentation.Avalonia.Views"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:ConfigBlockEditorViewModel">
  <Border Margin="0,4" Padding="12">
    <StackPanel Spacing="8">
      <TextBlock Classes="sectionTitle" Text="{Binding LocalizedTitle}" />
      <TextBlock
        Classes="caption"
        IsVisible="{Binding HasDescription}"
        Opacity="0.7"
        Text="{Binding LocalizedDescription}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <StackPanel
          IsVisible="{Binding ShowStudentPicker}"
          Orientation="Horizontal"
          Spacing="4">
          <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.ConfigBlock_Dataset}" />
          <ComboBox
            MinWidth="160"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AvailableDatasets}"
            SelectedItem="{Binding SelectedDataset}" />
        </StackPanel>
        <StackPanel
          IsVisible="{Binding ShowVenuePicker}"
          Orientation="Horizontal"
          Spacing="4">
          <TextBlock VerticalAlignment="Center" Text="{x:Static lang:Resources.ConfigBlock_Venue}" />
          <ComboBox
            MinWidth="160"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding AvailableVenues}"
            SelectedItem="{Binding SelectedVenue}" />
        </StackPanel>
      </StackPanel>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConfigBlockRowViewModel">
            <DockPanel Margin="0,2" LastChildFill="False">
              <TextBlock
                Width="24"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Text="{Binding Index}" />
              <StackPanel
                Margin="4,0"
                DockPanel.Dock="Left"
                IsVisible="{Binding ShowStudentPicker}">
                <ItemsControl ItemsSource="{Binding StudentPickers}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StudentPickerViewModel">
                      <views:StudentPickerView DataContext="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel
                Margin="4,0"
                DockPanel.Dock="Left"
                IsVisible="{Binding ShowSeatPosition}">
                <views:SeatPositionPickerView DataContext="{Binding SeatPicker}" />
              </StackPanel>
              <ComboBox
                MinWidth="100"
                Margin="4,0"
                DockPanel.Dock="Left"
                IsVisible="{Binding ShowGenderPicker}"
                ItemsSource="{x:Static vm:ConfigBlockRowViewModel.GenderOptions}"
                SelectedItem="{Binding GenderValue}" />
              <Button
                Width="28"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding $parent[UserControl].DataContext.RemoveRowCommand}"
                CommandParameter="{Binding}"
                Content="-"
                DockPanel.Dock="Left" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button
          Width="32"
          Command="{Binding AddRowCommand}"
          Content="+" />
        <Button
          AutomationProperties.Name="{x:Static lang:Resources.Common_Save}"
          Command="{Binding SaveConfigCommand}"
          Content="{x:Static lang:Resources.Common_Save}"
          IsEnabled="{Binding IsDirty}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
