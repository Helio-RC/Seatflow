<UserControl
  x:Class="SeatFlow.Presentation.Avalonia.Views.MainView"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:SeatFlow.Presentation.Avalonia.Controls"
  xmlns:fic="using:FluentIcons.Avalonia"
  xmlns:ficEnum="clr-namespace:FluentIcons.Common;assembly=FluentIcons.Common"
  xmlns:lang="using:SeatFlow.Presentation.Avalonia.Lang"
  xmlns:views="using:SeatFlow.Presentation.Avalonia.Views"
  xmlns:vm="using:SeatFlow.Presentation.Avalonia.ViewModels"
  x:DataType="vm:MainShellViewModel"
  DragDrop.AllowDrop="True"
  FontFamily="fonts:Inter#Inter">

  <Grid>
    <DockPanel IsEnabled="{Binding !Oobe.IsVisible}">
      <!--  紧凑档顶栏：导航抽屉入口 + 当前页标题（手机档无外壳顶栏，页面命令栏自带标题）  -->
      <Border
        DockPanel.Dock="Top"
        Classes="sf-toolbar"
        IsVisible="{Binding IsCompactTopBarVisible}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Shell_CompactNav}"
            Classes="sf-btn sf-sm"
            Command="{Binding ToggleNavDrawerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Navigation}" />
              <TextBlock
                VerticalAlignment="Center"
                Classes="sf-sm"
                Text="{x:Static lang:Resources.Shell_CompactNav}" />
            </StackPanel>
          </Button>
          <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="sf-h3"
            Text="{Binding CurrentPageTitle}" />
        </Grid>
      </Border>

      <!--  手机档底部 Tab 导航（排座 / 人员 / 会场 / 策略 / 更多；禁用页隐藏）  -->
      <Border
        DockPanel.Dock="Bottom"
        Classes="sf-tabbar"
        IsVisible="{Binding IsPhoneTabBarVisible}">
        <UniformGrid Rows="1">
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Nav_Seating}"
            Classes="sf-tab"
            Classes.sf-active="{Binding IsSeatingPage}"
            Command="{Binding NavigateCommand}"
            CommandParameter="SeatingArrangement"
            IsVisible="{Binding IsSeatingNavEnabled}">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="20"
                Icon="{x:Static ficEnum:Icon.Grid}" />
              <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Nav_Seating}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Nav_MemberManagement}"
            Classes="sf-tab"
            Classes.sf-active="{Binding IsMembersPage}"
            Command="{Binding NavigateCommand}"
            CommandParameter="MemberManagement"
            IsVisible="{Binding IsMembersNavEnabled}">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="20"
                Icon="{x:Static ficEnum:Icon.DataUsage}" />
              <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Nav_MemberManagement}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Nav_VenueConfig}"
            Classes="sf-tab"
            Classes.sf-active="{Binding IsVenuesPage}"
            Command="{Binding NavigateCommand}"
            CommandParameter="VenueConfiguration"
            IsVisible="{Binding IsVenuesNavEnabled}">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="20"
                Icon="{x:Static ficEnum:Icon.Building}" />
              <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Nav_VenueConfig}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Nav_StrategyConfig}"
            Classes="sf-tab"
            Classes.sf-active="{Binding IsStrategiesPage}"
            Command="{Binding NavigateCommand}"
            CommandParameter="StrategyConfiguration"
            IsVisible="{Binding IsStrategiesNavEnabled}">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="20"
                Icon="{x:Static ficEnum:Icon.Options}" />
              <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Nav_StrategyConfig}" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="{x:Static lang:Resources.Shell_More}"
            Classes="sf-tab"
            Classes.sf-active="{Binding IsMoreActive}"
            IsVisible="{Binding IsMoreTabVisible}"
            ToolTip.Tip="{x:Static lang:Resources.Shell_More}">
            <Button.Flyout>
              <MenuFlyout Placement="Top">
                <MenuItem
                  Command="{Binding NavigateCommand}"
                  CommandParameter="SnapshotHistory"
                  Header="{x:Static lang:Resources.Nav_SnapshotHistory}"
                  IsVisible="{Binding IsSnapshotsNavEnabled}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.History}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Settings"
                  Header="{x:Static lang:Resources.Nav_Settings}"
                  IsVisible="{Binding IsSettingsNavEnabled}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Settings}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                  Command="{Binding NavigateCommand}"
                  CommandParameter="About"
                  Header="{x:Static lang:Resources.Nav_About}"
                  IsVisible="{Binding IsAboutNavEnabled}">
                  <MenuItem.Icon>
                    <fic:FluentIcon FontSize="16" Icon="{x:Static ficEnum:Icon.Info}" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
            <StackPanel HorizontalAlignment="Center" Spacing="2">
              <fic:FluentIcon
                HorizontalAlignment="Center"
                FontSize="20"
                Icon="{x:Static ficEnum:Icon.MoreHorizontal}" />
              <TextBlock Classes="sf-xs" Text="{x:Static lang:Resources.Shell_More}" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </Border>

      <Grid ColumnDefinitions="Auto,*">
        <!--  ═══ 侧栏（桌面常驻 / 紧凑档左抽屉；手机档由底部 Tab 代替） ═══  -->
        <Border
          x:Name="RailPanel"
          Grid.Column="{Binding RailGridColumn}"
          Width="{Binding RailDisplayWidth}"
          HorizontalAlignment="{Binding RailHorizontalAlignment}"
          ZIndex="{Binding RailZIndex}"
          Background="{DynamicResource SfRailBgBrush}"
          BorderBrush="{DynamicResource SfBorderBrush}"
          BorderThickness="{Binding RailBorderThickness}"
          ClipToBounds="True"
          IsVisible="{Binding IsNavDrawerVisible}"
          KeyboardNavigation.TabNavigation="Cycle">
          <DockPanel>
            <!--  品牌区  -->
            <Border
              Height="52"
              Padding="12,0"
              DockPanel.Dock="Top">
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                  VerticalAlignment="Center"
                  Classes="sf-h3"
                  IsVisible="{Binding NavLabelVisible}"
                  Text="SeatFlow" />
              </StackPanel>
            </Border>

            <!--  底部：设置 + 关于  -->
            <Border
              Padding="8,8,8,10"
              BorderBrush="{DynamicResource SfBorderBrush}"
              BorderThickness="0,1,0,0"
              DockPanel.Dock="Bottom">
              <StackPanel Spacing="2">
                <Button
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_Settings}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsSettingsPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="Settings"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_Settings}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Settings}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_Settings}" />
                  </StackPanel>
                </Button>
                <Button
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_About}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsAboutPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="About"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_About}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Info}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_About}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!--  中部导航：可滚动 + 最小高度保护（修复 I-01：矮视口不再覆盖底部按钮）  -->
            <ScrollViewer
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,8,8,8" Spacing="2">
                <!--  折叠开关  -->
                <Button
                  x:Name="ToggleSidebarButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_ToggleSidebar}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Command="{Binding ToggleSidebarCommand}"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_CollapseSidebar}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon
                      FontSize="18"
                      Icon="{x:Static ficEnum:Icon.PanelLeftContract}"
                      IsVisible="{Binding !IsSidebarCollapsed}" />
                    <fic:FluentIcon
                      FontSize="18"
                      Icon="{x:Static ficEnum:Icon.PanelLeftExpand}"
                      IsVisible="{Binding IsSidebarCollapsed}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_CollapseSidebar}" />
                  </StackPanel>
                </Button>

                <!--  工作流  -->
                <TextBlock
                  Classes="sf-nav-group"
                  IsVisible="{Binding NavLabelVisible}"
                  Text="{x:Static lang:Resources.Nav_Group_Workflow}" />
                <Button
                  x:Name="SeatingButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_Seating}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsSeatingPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="SeatingArrangement"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_Seating}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Grid}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_Seating}" />
                  </StackPanel>
                </Button>

                <!--  资料  -->
                <TextBlock
                  Classes="sf-nav-group"
                  IsVisible="{Binding NavLabelVisible}"
                  Text="{x:Static lang:Resources.Nav_Group_Data}" />
                <Button
                  x:Name="MemberButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_MemberManagement}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsMembersPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="MemberManagement"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_MemberManagement}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.DataUsage}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_MemberManagement}" />
                  </StackPanel>
                </Button>
                <Button
                  x:Name="VenueButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_VenueConfig}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsVenuesPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="VenueConfiguration"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_VenueConfig}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Building}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_VenueConfig}" />
                  </StackPanel>
                </Button>

                <!--  规则  -->
                <TextBlock
                  Classes="sf-nav-group"
                  IsVisible="{Binding NavLabelVisible}"
                  Text="{x:Static lang:Resources.Nav_Group_Rules}" />
                <Button
                  x:Name="StrategyButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_StrategyConfig}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsStrategiesPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="StrategyConfiguration"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_StrategyConfig}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.Options}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_StrategyConfig}" />
                  </StackPanel>
                </Button>

                <!--  记录  -->
                <TextBlock
                  Classes="sf-nav-group"
                  IsVisible="{Binding NavLabelVisible}"
                  Text="{x:Static lang:Resources.Nav_Group_Records}" />
                <Button
                  x:Name="SnapshotButton"
                  AutomationProperties.Name="{x:Static lang:Resources.Nav_SnapshotHistory}"
                  HorizontalContentAlignment="{Binding NavContentAlignment}"
                  Padding="{Binding NavButtonPadding}"
                  Classes="sf-nav"
                  Classes.sf-active="{Binding IsSnapshotsPage}"
                  Command="{Binding NavigateCommand}"
                  CommandParameter="SnapshotHistory"
                  ToolTip.Tip="{x:Static lang:Resources.Nav_SnapshotHistory}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <fic:FluentIcon FontSize="18" Icon="{x:Static ficEnum:Icon.History}" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Classes="sf-sm"
                      IsVisible="{Binding NavLabelVisible}"
                      Text="{x:Static lang:Resources.Nav_SnapshotHistory}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!--  紧凑档抽屉遮罩：点击关闭  -->
        <Border
          x:Name="RailMask"
          Grid.ColumnSpan="2"
          ZIndex="30"
          AutomationProperties.Name="{x:Static lang:Resources.Shell_CloseOverlay}"
          Background="{DynamicResource SfModalMaskBrush}"
          IsVisible="{Binding IsMaskVisible}"
          PointerPressed="OnNavMaskPressed" />

        <!--  内容区域（页面切换即时化：无淡出/间隔）  -->
        <ContentControl
          x:Name="PageHost"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Content="{Binding CurrentViewModel}" />
      </Grid>
    </DockPanel>

    <!--  文件拖放导入覆盖层  -->
    <Border
      x:Name="FileDropOverlay"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      Background="{DynamicResource OverlayMaskBrush}"
      IsVisible="False"
      ZIndex="100">
      <Border
        x:Name="FileDropOverlayCard"
        MaxWidth="320"
        Padding="48,40"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
        BorderBrush="{DynamicResource SystemAccentColor}"
        BorderThickness="3"
        CornerRadius="12">
        <StackPanel HorizontalAlignment="Center" Spacing="16">
          <fic:FluentIcon
            x:Name="FileDropOverlayIcon"
            Height="56"
            HorizontalAlignment="Center"
            FontSize="56"
            Foreground="{DynamicResource SystemAccentColor}"
            Icon="{x:Static ficEnum:Icon.ArrowDownload}" />
          <TextBlock
            x:Name="FileDropOverlayText"
            HorizontalAlignment="Center"
            Classes="heading"
            FontSize="18"
            Text="{x:Static lang:Resources.DragDrop_DropHint}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>

    <!--  OOBE 全屏覆盖层（位于外壳之上、对话框之下）  -->
    <views:OobeView
      DataContext="{Binding Oobe}"
      ZIndex="200" />

    <!--  OOBE 交接卡：高亮生成按钮，非模态  -->
    <controls:CoachMarkOverlay x:Name="OobeCoachMark" ZIndex="210" />

    <!--  浏览器版（WASM）对话框叠加层：无独立 Window 时以遮罩 + 居中面板呈现  -->
    <Grid
      x:Name="DialogOverlayHost"
      Background="#66000000"
      IsVisible="False"
      ZIndex="300">
      <ContentControl
        x:Name="DialogOverlayContent"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
