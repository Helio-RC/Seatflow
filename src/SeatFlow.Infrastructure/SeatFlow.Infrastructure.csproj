<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SeatFlow.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EPPlus" Version="8.7.1" />
    <!-- 覆盖 EPPlus 传递依赖的 System.Security.Cryptography.Xml 10.0.7 (存在 CVE 漏洞) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <!-- QuestPDF/SkiaSharp 仅桌面目标：WASM 下不可用（Phase 0 验证结论） -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" Condition="'$(TargetFramework)' != 'net10.0-browser'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" Condition="'$(TargetFramework)' != 'net10.0-browser'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-browser'">
    <!-- QuestPDF 2026.9.0+ 默认不再回退系统字体且强制字形检查：嵌入 Noto Sans SC
         供 PdfSeatingExporter 注册为 CJK 回退（桌面与测试同源，不依赖运行环境字体）。 -->
    <EmbeddedResource Include="..\SeatFlow.Presentation.Avalonia\Assets\Fonts\NotoSansSC-Regular.otf"
                      LogicalName="SeatFlow.Infrastructure.Assets.NotoSansSC-Regular.otf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SeatFlow.Core\SeatFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migration\file_versions.json" />
    <EmbeddedResource Include="Data\field_mappings.json" />
  </ItemGroup>

  <Target Name="_GetPackageRefs" Returns="@(PackageReference)" />

</Project>
